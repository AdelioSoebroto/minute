def fill_template(doc, tp, data):
    """Write the minutes into the template wherever the profile says each field lives."""
    import copy
    values = {"agenda": [data.get("agenda", "")], "date": [data.get("date", "")], "time": [data.get("time", "")],
              "internal_names": data.get("telkomsel_names", []), "internal_unit": [data.get("telkomsel_unit", "")],
              "external_names": data.get("third_party_names", []), "external_company": [data.get("third_party_company", "")]}
    for k, lines in values.items():
        rc = tp["map"].get(k)
        if not rc: continue
        try: set_lines(doc.tables[rc[0]].rows[rc[1]].cells[rc[2]], lines)
        except Exception as e: log(f"could not fill {k}: {e!r}")
    style = tp.get("topic_style", "List Paragraph")
    items = [p for p in doc.paragraphs if p.style.name == style]
    topics = data.get("topics", [])
    xml_space = "{http://www.w3.org/XML/1998/namespace}space"
    def clone(proto, text):
        p = copy.deepcopy(proto)
        runs = p.findall(W_NS + "r")
        for r in runs[1:]: p.remove(r)
        if runs:
            ts_ = runs[0].findall(W_NS + "t")
            for x in ts_[1:]: runs[0].remove(x)
            if ts_: ts_[0].text = text; ts_[0].set(xml_space, "preserve")
        else:
            r = p.makeelement(W_NS + "r", {}); t_ = r.makeelement(W_NS + "t", {}); t_.text = text; t_.set(xml_space, "preserve"); r.append(t_); p.append(r)
        return p
    if items:
        proto = items[0]._p; anchor = items[-1]._p
        for topic in topics:
            p = clone(proto, topic); anchor.addnext(p); anchor = p
        for p in items: p._p.getparent().remove(p._p)
    else:
        paras = doc.paragraphs
        th = tp.get("topic_heading", -1)
        anchor = paras[th]._p if 0 <= th < len(paras) else (paras[-1]._p if paras else None)
        if anchor is not None:
            for i, topic in enumerate(topics):
                np_ = doc.add_paragraph(f"{i + 1}. {topic}")._p
                np_.getparent().remove(np_); anchor.addnext(np_); anchor = np_


# ---------- export: MoM.json + template.docx -> MoM.docx + MoM.pdf ----------
def set_lines(tc_cell, lines):
    """Replace the text of a table cell with one paragraph per line, keeping the first paragraph's formatting."""
    import copy
    xml_space = "{http://www.w3.org/XML/1998/namespace}space"
    paras = tc_cell.paragraphs
    proto = copy.deepcopy(paras[0]._p)
    for p in paras: p._p.getparent().remove(p._p)
    tc = tc_cell._tc
    for line in (lines or [""]):
        p = copy.deepcopy(proto)
        runs = p.findall(W_NS + "r")
        for r in runs[1:]: p.remove(r)
        if runs:
            ts_ = runs[0].findall(W_NS + "t")
            for t in ts_[1:]: runs[0].remove(t)
            if ts_: ts_[0].text = line; ts_[0].set(xml_space, "preserve")
            else:
                t_ = runs[0].makeelement(W_NS + "t", {}); t_.text = line; t_.set(xml_space, "preserve"); runs[0].append(t_)
        else:
            r = p.makeelement(W_NS + "r", {}); t_ = r.makeelement(W_NS + "t", {}); t_.text = line; t_.set(xml_space, "preserve"); r.append(t_); p.append(r)
        tc.append(p)

def export_stem(data, d: Path):
    """MOM_<Document name>_<yyyymmdd>, e.g. "MOM_Update SSL Ondeck_20261020": spaces inside the document name, underscores only between the parts."""
    name = re.sub(r"[\W_]+", " ", data.get("agenda", "") or "", flags=re.UNICODE).strip()[:60].strip() or "Meeting"
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", d.name)
    day = "".join(m.groups()) if m else time.strftime("%Y%m%d")
    return f"MOM_{name}_{day}"

def make_pdf(final_docx: Path, final_pdf: Path):
    stage("Creating PDF")
    # Word opens files in synced or quarantined folders in Protected View, which cannot export. Convert a copy in a plain work folder.
    work = HOME / ".mom/work"; work.mkdir(parents=True, exist_ok=True)
    out = work / "MoM.docx"; shutil.copy2(final_docx, out)
    run(["xattr", "-c", str(out)])
    pdf = work / "MoM.pdf"
    if pdf.exists(): pdf.unlink()
    script = f'''tell application "Microsoft Word"
  open POSIX file "{out}"
  repeat 40 times
    try
      if (count of documents) > 0 then exit repeat
    end try
    delay 0.5
  end repeat
  set dd to active document
  save as dd file name "{pdf}" file format format PDF
  close dd saving no
end tell'''
    err = ""
    for attempt in range(3):
        r = run(["osascript", "-e", script])
        if pdf.exists(): break
        err = r.stderr[-300:]; log(f"pdf attempt {attempt + 1} failed: {err}")
        run(["osascript", "-e", 'tell application "Microsoft Word" to close every document saving no'])
        time.sleep(2)
    if not pdf.exists():
        raise SystemExit("PDF export failed (needs Microsoft Word; the Word file was saved as " + final_docx.name + "): " + err)
    shutil.move(str(pdf), str(final_pdf)); out.unlink(missing_ok=True)

def export(d: Path):
    import docx, copy
    data = json.loads((d / "MoM.json").read_text())
    learn_terms(data)
    tp = template_profile()
    doc = docx.Document(str(TEMPLATE))
    fill_template(doc, tp, data)
    stem = export_stem(data, d)
    for old in list(d.glob("MOM_*.docx")) + list(d.glob("MOM_*.pdf")) + [d / "MoM.docx", d / "MoM.pdf"]:
        old.unlink(missing_ok=True)      # replace earlier exports of this meeting (the title may have changed)
    final_docx, final_pdf = d / f"{stem}.docx", d / f"{stem}.pdf"
    doc.save(str(final_docx))
    make_pdf(final_docx, final_pdf)
    (d / "exports.json").write_text(json.dumps({"docx": final_docx.name, "pdf": final_pdf.name}))
    if CFG.get("delete_audio"):          # optional privacy setting: keep only the transcript and minutes
        for a in list(d.glob("mic*.caf")) + list(d.glob("system*.caf")): a.unlink(missing_ok=True)
    print("DONE", d, flush=True)

# ---------- tidy: clean up spacing, wording, punctuation of an edited MoM.json ----------
def tidy_text(t, sentence=True):
    t = re.sub(r"\s+", " ", t or "").strip()
    t = re.sub(r"\s+([,.;:!?])", r"\1", t)                    # no space before punctuation
    t = re.sub(r"([,;:!?])(?=[^\s\d,;:!?)\]\"'])", r"\1 ", t)   # one space after
    if sentence and t:
        t = t[0].upper() + t[1:]
        if t[-1] not in ".!?:)": t += "."
    return t

def tidy_name(n):
    n = re.sub(r"\s+", " ", n or "").strip(" ,;")
    return n.title() if n and (n.islower() or n.isupper()) else n

def tidy_names(names):
    out, seen = [], set()
    for n in names:
        n = tidy_name(n)
        if n and n.lower() not in seen: seen.add(n.lower()); out.append(n)
    return out

TIDY_SYSTEM = """You are a careful copy editor for formal corporate minutes of meeting. You receive the topic list of a MoM.
Fix spelling, grammar, spacing, punctuation and awkward wording. Make each topic a clear, concise, formal sentence or two (passive voice is fine). Keep the language of each topic (Bahasa Indonesia stays Bahasa Indonesia; keep English technical terms). Keep every fact, name, number, date, time and owner exactly; never add or remove information. Keep the same number of topics in the same order. If a topic is already good, return it unchanged."""

def tidy(d: Path):
    f = d / "MoM.json"
    data = json.loads(f.read_text())
    (d / "MoM.pre-tidy.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
    stage("Tidying")
    data["agenda"] = tidy_text(data.get("agenda", ""), sentence=False)
    data["telkomsel_unit"] = tidy_text(data.get("telkomsel_unit", ""), sentence=False)
    data["third_party_company"] = tidy_text(data.get("third_party_company", ""), sentence=False)
    data["telkomsel_names"] = tidy_names(data.get("telkomsel_names", []))
    data["third_party_names"] = tidy_names(data.get("third_party_names", []))
    topics = [tidy_text(t) for t in data.get("topics", []) if t.strip()]
    if topics:
        try:
            stage("Polishing the wording")
            ensure_ollama()
            schema = {"type": "object", "required": ["topics"], "properties": {"topics": {"type": "array", "items": {"type": "string"}}}}
            out = json.loads(chat(TIDY_SYSTEM, json.dumps({"topics": topics}, ensure_ascii=False), schema))
            new = [tidy_text(t) for t in out.get("topics", [])]
            if len(new) == len(topics) and all(new): topics = new   # only accept a faithful, same-length rewrite
        except Exception as e:
            print("tidy: wording pass skipped:", e, flush=True)
    data["topics"] = topics
    f.write_text(json.dumps(data, ensure_ascii=False, indent=2))
    print("DONE", d, flush=True)

def ask(d: Path, question: str):
    tr = (d / "transcript.md").read_text() if (d / "transcript.md").exists() else ""
    if not tr: raise SystemExit("This meeting has no transcript yet.")
    ensure_ollama()
    mom = (d / "MoM.json").read_text() if (d / "MoM.json").exists() else ""
    print(chat("You answer questions about one meeting using only its transcript (and minutes). Answer briefly and plainly in the language of the question. Quote the timestamp [hh:mm:ss] where the answer is said. If the meeting does not say, answer that it was not discussed.",
               f"TRANSCRIPT:\n{tr[:80000]}\n\nMINUTES:\n{mom}\n\nQUESTION: {question}"))

def single_run():
    """Only one heavy job at a time: queued runs wait instead of piling up and heating the Mac."""
    import fcntl
    f = open(HOME / ".mom/run.lock", "w")
    try: fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        stage("Waiting for the previous job to finish")
        fcntl.flock(f, fcntl.LOCK_EX)
    return f

def diagnostics(folder=None):
    home = str(HOME)
    out = ["Minute diagnostics", f"python {sys.version.split()[0]}", f"macOS {sh(['/usr/bin/sw_vers', '-productVersion']).strip()}"]
    try: out.append("doctor: " + json.dumps(doctor()))
    except Exception as e: out.append("doctor failed: " + repr(e))
    out.append("config: " + json.dumps({k: v for k, v in CFG.items() if k not in ("my_name", "my_unit")}))
    if folder:
        f = Path(folder) / "mom.log"
        out.append(f"--- {Path(folder).name}/mom.log (last 60 lines)")
        if f.exists(): out += f.read_text().splitlines()[-60:]
        out.append("files: " + ", ".join(sorted(p.name for p in Path(folder).iterdir())))
    return "\n".join(out).replace(home, "~")

def _on_term(sig, frm):
    try: os.killpg(os.getpgrp(), signal.SIGKILL)
    except Exception: os._exit(1)

def main():
    global LOGF
    args = sys.argv[1:]
    try: os.setpgrp()
    except Exception: pass
    signal.signal(signal.SIGTERM, _on_term)
    if len(args) >= 2 and not args[0].startswith("--"):
        pass
    for a in args:
        if not a.startswith("--") and Path(a).expanduser().is_dir():
            LOGF = Path(a).expanduser() / "mom.log"; break
    (HOME / ".mom").mkdir(parents=True, exist_ok=True)
    LIGHT = {"--doctor", "--hardware", "--diagnostics", "--get-whisper", "--install-tools", "--install-docx", "--pull-model", "--test-pdf", "--make-template"}
    _lock = None if args and args[0] in LIGHT else single_run()      # quick checks and installs never wait behind a long job
    if args and args[0] == "--ask":
        return ask(Path(args[1]).expanduser().resolve(), " ".join(args[2:]))
    if not args: raise SystemExit(__doc__)
    if args[0] == "--tidy":
        return tidy(Path(args[1]).expanduser().resolve())
    if args[0] == "--export":
        return export(Path(args[1]).expanduser().resolve())
    if args[0] == "--hardware":
        pr = profile(); model = CFG["llm"] if LLM_PINNED else pr["model"]
        have = False
        if ollama_up() or shutil.which("ollama"):
            have = model in sh(["ollama", "list"]) if shutil.which("ollama") else False
        chip = sh(["/usr/sbin/sysctl", "-n", "machdep.cpu.brand_string"]).strip()
        print("HARDWARE " + json.dumps({"chip": chip, "ram": pr["ram"], "tier": pr["tier"], "model": model, "installed": have,
                                        "ollama": bool(shutil.which("ollama")), "size_gb": 5.2 if model.endswith("8b") else 2.6}), flush=True)
        return
    if args[0] == "--diagnostics":
        print(diagnostics(args[1] if len(args) > 1 else None)); return
    if args[0] == "--test-pdf":
        # asks macOS for the Word automation and file-access permissions once, during setup, so exports never interrupt later
        import docx
        t = HOME / ".mom/work"; t.mkdir(parents=True, exist_ok=True)
        dd = docx.Document(); dd.add_paragraph("Minute setup check")
        src, dst = t / "setup-check.docx", t / "setup-check.pdf"
        dd.save(str(src))
        if not Path("/Applications/Microsoft Word.app").exists(): raise SystemExit("Microsoft Word is not installed; you will get Word files without PDFs.")
        make_pdf(src, dst)
        src.unlink(missing_ok=True); dst.unlink(missing_ok=True)
        print("DONE", flush=True); return
    if args[0] == "--doctor":
        print("DOCTOR " + json.dumps(doctor()), flush=True); return
    if args[0] == "--get-whisper": return get_whisper()
    if args[0] == "--install-tools": return install_tools()
    if args[0] == "--install-docx":
        stage("Installing Word file support")
        r = run(["/usr/bin/python3", "-m", "pip", "install", "--user", "python-docx"])
        if r.returncode: raise SystemExit("Could not install python-docx: " + r.stderr[-200:])
        print("DONE", flush=True); return
    if args[0] == "--pull-model":
        model = CFG["llm"] if LLM_PINNED else profile()["model"]
        if not shutil.which("ollama"): raise SystemExit("The language engine (Ollama) is not installed yet.")
        if not ollama_up():
            ensure_ollama_server = subprocess.Popen(["ollama", "serve"], env={**os.environ, "OLLAMA_HOST": "127.0.0.1:11434"}, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            for _ in range(30):
                if ollama_up(): break
                time.sleep(1)
        stage("Downloading the language model")
        if _stream(["ollama", "pull", model], "Downloading the language model"): raise SystemExit("Download failed. Check the connection and try again.")
        print("DONE", flush=True); return
    if args[0] == "--learn-template":
        org = args[args.index("--org") + 1] if "--org" in args else ""
        tp = learn_template(Path(args[1]).expanduser().resolve(), org=org)
        print("TEMPLATE " + json.dumps({"found": tp["found"], "org": tp["org"], "labels": tp["labels"], "topics": bool(tp.get("has_examples") or tp.get("topic_heading", -1) >= 0)}), flush=True)
        unload(); return
    if args[0] == "--make-template":
        org = args[args.index("--org") + 1] if "--org" in args else ""
        logo = Path(args[args.index("--logo") + 1]).expanduser() if "--logo" in args else None
        tp = make_generic_template(logo, org)
        print("TEMPLATE " + json.dumps({"found": tp["found"], "org": tp["org"], "labels": tp["labels"], "topics": bool(tp.get("has_examples") or tp.get("topic_heading", -1) >= 0)}), flush=True)
        return
    if args[0] == "--draft":
        d = Path(args[1]).expanduser().resolve()
        learn_from_edits(d)
        transcript = re.sub(r"^# Transcript\s*", "", (d / "transcript.md").read_text()).strip()
        if len(transcript) < 20: raise SystemExit("The transcript is empty. Add some text first.")
        ensure_ollama()
        data = make_mom(transcript, d)
        (d / "MoM.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
        try: harvest_terms(d)
        except Exception as e: log("term harvest skipped: " + repr(e))
        print("DONE", d, flush=True); return
    d, tracks = prepare(Path(args[0]).expanduser().resolve())
    if not tracks: raise SystemExit("No audio found in " + str(d))
    if not Path(CFG["whisper_model"]).exists(): raise SystemExit("Whisper model missing: " + CFG["whisper_model"])
    segs = []
    with tempfile.TemporaryDirectory() as t:
        tmp = Path(t)
        wavs = {}
        for label, src in tracks:
            stage(f"Preparing {label} audio")
            wav = tmp / f"{label}.wav"; to_wav(src, wav); wavs[label] = wav
        if "Me" in wavs and "Others" in wavs:
            stage("Removing speaker bleed from the mic")
            clean = tmp / "Me_clean.wav"
            if suppress_bleed(wavs["Me"], wavs["Others"], clean) is not None and clean.exists(): wavs["Me"] = clean
        for label, _ in tracks:
            segs += transcribe(label, wavs[label], tmp, 0, len(tracks))
    segs.sort(key=lambda x: x[0])
    segs = drop_hallucinations(drop_echo(segs))
    lines, prev = [], None
    for s, who, text in segs:
        # one line per breath, like a captioned recording: same speaker keeps one line only while there is no pause and it stays short
        if prev and prev[0] == who and s - prev[1] < 2.5 and not re.search(r"[.!?…][\"')]*$", lines[-1]) and len(lines[-1]) < 220: lines[-1] += " " + text
        else: lines.append(f"[{ts(s)}] {who}: {text}")
        prev = (who, s + 1)
    transcript = apply_corrections("\n".join(lines))
    if len(transcript) >= 80:
        try:
            ensure_ollama(); transcript = fix_terms(transcript, screen_terms(d))
        except (Exception, SystemExit) as e:
            log("name check skipped: " + repr(e))
    (d / "transcript.md").write_text("# Transcript\n\n" + transcript + "\n")
    (d / "transcript.orig.md").write_text("# Transcript\n\n" + transcript + "\n")
    if len(transcript) < 80: raise SystemExit("Transcript is nearly empty. Check microphone / meeting audio levels.")
    if "--transcript-only" in args:
        print("DONE", d, flush=True); return
    ensure_ollama()
    data = make_mom(transcript, d)
    (d / "MoM.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
    print("DONE", d, flush=True)

def unload():
    """Free the model's RAM as soon as we are done instead of keeping ~10 GB resident."""
    try:
        req = urllib.request.Request("http://127.0.0.1:11434/api/generate", json.dumps({"model": CFG["llm"], "keep_alive": 0}).encode(), {"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=10).read()
    except Exception: pass

if __name__ == "__main__":
    import atexit; atexit.register(unload)
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        import traceback
        log(traceback.format_exc())
        print(f"{type(e).__name__}: {e}", flush=True)
        sys.exit(1)
