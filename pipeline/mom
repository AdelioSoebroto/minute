                   "informal_terms": {"type": "array", "items": {"type": "string"}}}}

def analyse(transcript: str, meta: str):
    """Read the conversation the way a person would: what was decided, who took what, by when. Handles casual speech, slang and code-switching."""
    system = ("You are an experienced Indonesian corporate secretary who attended this meeting. The transcript is a raw speech-to-text of real, natural conversation: "
              "it mixes formal and informal (casual, slang, Jaksel-style) Bahasa Indonesia and English, with fillers, half sentences, interruptions, jokes and agreement noises. Read it as a human would.\n"
              "Understand slang and casual wording using this lexicon (said = meaning):\n" + slang_lines() + "\n"
              "Do the following:\n- Ignore filler, small talk and jokes unless they carry a decision.\n"
              "- Work out real intent: 'gas aja', 'oke sip', 'acc' mean agreement; 'nanti gue kabarin' is a commitment by the speaker; 'kayaknya', 'mungkin' mean not yet decided.\n"
              "- Who said it: " + "'Me' is the person who recorded the meeting, " + CFG["my_name"] + "; 'Others' are the remaining participants whose names are only known if said aloud; a line labelled with a person's name is that person. "
              "In your output never write the words Me, Others or Speaker: use " + CFG["my_name"] + " for Me, the person's name if it was said, or 'peserta rapat' / 'pihak terkait' when unknown.\n"
              "- Assign an owner only if a person is named or clearly the speaker; otherwise 'Unassigned'.\n"
              "- Convert relative dates (besok, lusa, minggu depan, nanti sore) to absolute dates using the meeting date given; if unclear write 'TBD'.\n"
              "- decisions: only what was actually agreed. action_items: concrete tasks with owner and due. open_questions: unresolved points.\n"
              "- informal_terms: any slang you had to interpret, as 'said = meaning'.\n"
              "- summary: 2-3 plain sentences of what the meeting was about.\n" +
              ("Write in formal English. Never invent facts." if CFG["mom_language"] == "en" else "Write in formal Bahasa Indonesia (keep English technical terms). Never invent facts."))
    return json.loads(chat(system, f"MEETING INFO: {meta}\n\nTRANSCRIPT:\n{transcript}", ANALYSIS_SCHEMA))

def make_mom(transcript: str, session: Path):
    lang = {"auto": ("Write the topics in the main language of the meeting, keeping English technical terms as spoken." if template_profile().get("generic") else "Write the topics in Bahasa Indonesia, keeping English technical terms as spoken."),
            "en": "Write the topics in English.", "id": "Write the topics in Bahasa Indonesia."}.get(CFG["mom_language"], "Write the topics in Bahasa Indonesia.")
    ex = template_examples()
    mine = past_examples(session)
    if mine: ex += "\nMore examples from this user's earlier minutes (match their wording):\n" + mine
    tp = template_profile()
    system = SYSTEM.format(lang=lang, examples=ex, me=CFG["my_name"] or "the user", team=tp["team"], internal=tp["internal"])
    lex = lexicon()
    if lex: system += "\nCommon Indonesian names (brands, restaurants, shops, banks, places, institutions), SPELLING REFERENCE ONLY: if the transcript has an unfamiliar word or acronym that clearly refers to one of these (by sound and context), write it as listed. Never add a name that was not mentioned. " + "; ".join(lex)[:3500]
    gl = glossary()
    if gl: system += "\nKnown names and terms, SPELLING REFERENCE ONLY (use these spellings when the transcript has a similar-sounding word). These people and terms are NOT necessarily in this meeting: never add anyone to the attendee lists unless the transcript mentions them: " + "; ".join(gl[-80:])
    if len(transcript) > (profile()["ctx_cap"] - 5000) * 2.8:  # map-reduce for very long meetings
        parts, cur = [], ""
        for line in transcript.splitlines(keepends=True):
            if len(cur) + len(line) > (profile()["ctx_cap"] - 6000) * 2.2: parts.append(cur); cur = ""
            cur += line
        parts.append(cur)
        notes = []
        for i, p in enumerate(parts):
            stage(f"Summarising part {i + 1} of {len(parts)}")
            notes.append(chat("Condense this meeting transcript part into detailed bullet notes: topics, who said what, decisions, action items with owners and due dates, numbers, names.", p))
        transcript = "\n\n".join(notes)
    n0 = session.name
    meta = f"Recorded {n0[:10]} at {n0[11:13]}:{n0[13:15]}"
    extra = context_block(session)
    try:
        import datetime
        day0 = datetime.date(int(n0[:4]), int(n0[5:7]), int(n0[8:10]))
        hari = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"]
        bulan = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]
        cal = "; ".join(f"{hari[(day0 + datetime.timedelta(days=k)).weekday()]} {(day0 + datetime.timedelta(days=k)).day} {bulan[(day0 + datetime.timedelta(days=k)).month - 1]} {(day0 + datetime.timedelta(days=k)).year}" + (" (hari ini)" if k == 0 else " (besok)" if k == 1 else "") for k in range(0, 15))
        meta += f" ({hari[day0.weekday()]}). Calendar, use it to turn weekday names and relative dates into exact dates, the next occurrence of a weekday is the first one listed: {cal}"
    except Exception: pass
    if extra: meta += "\n" + extra
    notes = ""
    try:
        import datetime
        transcript = annotate_dates(transcript, datetime.date(int(n0[:4]), int(n0[5:7]), int(n0[8:10])))
    except Exception as e:
        log("date annotation skipped: " + repr(e))
    try:
        stage("Understanding the conversation")
        an = analyse(transcript, meta)
        (session / "analysis.json").write_text(json.dumps(an, ensure_ascii=False, indent=2))
        notes = "\n\nANALYSIS OF THE MEETING (use it, but stay faithful to the transcript):\n" + json.dumps(an, ensure_ascii=False)
    except Exception as e:
        log("analysis skipped: " + repr(e))
    system += "\nThe transcript is casual and mixed-register. Write the minutes in formal, professional language regardless of how informally it was spoken; do not copy slang. Express one-off relative dates as absolute dates, but keep recurring ones recurring: 'setiap Senin', 'every Monday' must stay 'setiap Senin' with no date added."
    stage("Writing the MoM")
    data = json.loads(chat(system, f"MEETING INFO: {meta}\n\nTRANSCRIPT:\n{transcript}{notes}", SCHEMA))
    # second pass: check the draft against the transcript and drop anything it does not support
    try:
        if not profile()["verify"]: raise RuntimeError("eco profile: fact-check skipped")
        stage("Checking the minutes against the transcript")
        checked = json.loads(chat(
            "You are a strict fact-checker for minutes of meeting. Compare the DRAFT with the TRANSCRIPT. Remove or correct any statement, name, number, date or owner that the transcript does not support. Fix names and terms to match the known spellings" + (" (spelling reference only; remove any attendee that the transcript does not mention): " + "; ".join(gl[-80:]) if gl else "") + ". Keep the style and language. Do not add new topics unless an important decision or action item in the transcript is missing, then add it. Return the corrected draft in the same JSON format.",
            f"MEETING INFO: {meta}\n\nTRANSCRIPT (casual speech; slang lexicon: {slang_lines()[:1500]}):\n{transcript}\n\nDRAFT:\n{json.dumps(data, ensure_ascii=False)}", SCHEMA))
        if checked.get("topics"): data = checked
    except Exception as e:
        log("verify pass skipped: " + repr(e))
    for k in ("telkomsel_names", "third_party_names"):
        data[k] = [x for x in data.get(k, []) if x.strip().lower() not in ("me", "others", "speaker", "unidentified", "unknown")]
    low = transcript.lower()
    def mentioned(n):
        return any(len(t) >= 3 and t.lower() in low for t in n.split())
    for k in ("telkomsel_names", "third_party_names"):
        data[k] = [x for x in data.get(k, []) if mentioned(x)]   # never list someone the transcript does not mention
    try:
        import datetime
        day0 = datetime.date(int(session.name[:4]), int(session.name[5:7]), int(session.name[8:10]))
        said_days = {h.lower() for h in HARI if h.lower() in transcript.lower()}
        data["topics"] = [fix_weekday_dates(t, day0, said_days) for t in data.get("topics", [])]
        data["topics"] = drop_unsupported_dates(data["topics"], transcript, day0)
    except Exception as e:
        log("date fix skipped: " + repr(e))
    for k in ("telkomsel_names", "third_party_names"):
        data[k] = [re.sub(r"\s*\(.*?\)", "", x).strip() for x in data.get(k, [])]
    tel = [x.lower() for x in data.get("telkomsel_names", [])]
    data["third_party_names"] = [x for x in data.get("third_party_names", []) if not any(t == x.lower() or t.startswith(x.lower() + " ") for t in tel)]
    if not data["third_party_names"] and data.get("third_party_company", "").lower() == tp["internal"].lower(): data["third_party_company"] = ""
    try:    # completeness: every deadline/date said in the meeting must show up in the minutes
        import datetime
        day0 = datetime.date(int(session.name[:4]), int(session.name[5:7]), int(session.name[8:10]))
        missing = []
        for m_ in re.finditer(r"[^.?!\n]*\[(?:\w+ (\d{1,2}) (\w+) (\d{4}))\][^.?!\n]*", transcript):
            if "week of" in m_.group(0): continue
            ds = f"{m_.group(1)} {m_.group(2)}"
            if ds == f"{day0.day} {BULAN[day0.month - 1]}": continue      # 'hari ini' needs no extra topic
            if not any(ds in t for t in data.get("topics", [])): missing.append(m_.group(0).strip())
        if missing:
            stage("Adding missing dates and deadlines")
            fixed = json.loads(chat("You complete minutes of meeting. Some sentences from the meeting mention a date or deadline (the exact date is in square brackets) that the minutes do not yet contain. Add each one to the most relevant existing topic, or add one short new topic. Keep every existing topic, formal Bahasa Indonesia, no invented facts. Return all topics.",
                f"MINUTES TOPICS:\n{json.dumps(data['topics'], ensure_ascii=False)}\n\nMISSING:\n" + "\n".join(missing), {"type": "object", "required": ["topics"], "properties": {"topics": {"type": "array", "items": {"type": "string"}}}}))
            if len(fixed.get("topics", [])) >= len(data["topics"]): data["topics"] = fixed["topics"]
    except Exception as e:
        log("completeness pass skipped: " + repr(e))
    few = len([t for t in data.get("topics", []) if t.strip()]) <= 1 and len(transcript.split()) > 60
    if few or not [t for t in data.get("topics", []) if t.strip()]:
        # a lecture, seminar or informal talk can have no decisions, but the minutes must still say what was discussed (and not squeeze several points into one)
        try:
            stage("Summarising the discussion")
            out = json.loads(chat("You write the 'topics discussed' list of minutes of meeting. Whatever the meeting was (a decision meeting, a talk, a seminar, a casual chat), list the main points that were actually said, one numbered item per point, each one or two clear sentences in the same language as the transcript, third person, formal. Never invent anything, never return an empty list. " + lang,
                f"TRANSCRIPT:\n{transcript}", {"type": "object", "required": ["topics"], "properties": {"topics": {"type": "array", "items": {"type": "string"}}}}))
            more = [t.strip() for t in out.get("topics", []) if t.strip()]
            if len(more) > len([t for t in data.get("topics", []) if t.strip()]): data["topics"] = more
        except Exception as e:
            log("topic fallback failed: " + repr(e))
    data["topics"] = [re.sub(r"\s*\[([^\]]*)\]", r" \1", t).replace("  ", " ").strip() for t in data.get("topics", [])]   # never leak the date hints
    me = CFG["my_name"]
    if me and me.lower() not in [x.lower() for x in data.get("telkomsel_names", [])]:
        data["telkomsel_names"] = [me] + [x for x in data.get("telkomsel_names", []) if not x.lower().startswith(me.lower().split()[0]) or x.lower() == me.lower()]
        if not data.get("telkomsel_unit") and CFG.get("my_unit"): data["telkomsel_unit"] = CFG["my_unit"]
    data["topics"] = [re.sub(r"\b(Me|Others|Speaker)\b", lambda m_: me if m_.group(1) == "Me" else "peserta rapat", t) for t in data.get("topics", [])]
    n = session.name
    try:
        y, mo, d = int(n[:4]), int(n[5:7]), int(n[8:10]); hh, mm = int(n[11:13]), int(n[13:15])
        data["date"] = nice_date(y, mo, d)
        data["time"] = f"{(hh % 12) or 12}:{mm:02d} {'AM' if hh < 12 else 'PM'}"
    except Exception:
        data.setdefault("date", ""); data.setdefault("time", "")
    return data

# ---------- templates: learn any Word template, or build a clean generic one ----------
TEMPLATE = HOME / ".mom/template.docx"
TPL_JSON = HOME / ".mom/template.json"
W_NS = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
SLOTS = ["agenda", "date", "time", "internal_names", "internal_unit", "external_names", "external_company"]
DEFAULT_LABELS = {"agenda": "Meeting Agenda", "date": "Date", "time": "Time", "participants": "List of Participants",
                  "internal": "Internal", "external": "External", "topics": "Topics Discussed"}
# the layout the built-in generic template uses (and the fallback if nothing else is known)
GENERIC_MAP = {"agenda": [0, 0, 1], "date": [0, 1, 1], "time": [0, 2, 1], "internal_names": [0, 5, 0], "internal_unit": [0, 5, 2],
               "external_names": [0, 7, 0], "external_company": [0, 7, 2]}

def template_profile():
    """What the current template looks like: where each field goes and how it is labelled. Learned once, stored in ~/.mom/template.json."""
    try:
        tp = json.loads(TPL_JSON.read_text())
    except Exception:
        tp = None
    if tp is None:
        if TEMPLATE.exists():
            try: tp = learn_template(TEMPLATE, install=False)
            except Exception as e: log("template learn failed: " + repr(e))
        if tp is None:
            tp = {"generic": True, "map": GENERIC_MAP, "labels": DEFAULT_LABELS, "topic_style": "List Number", "topic_heading": -1, "org": ""}
    tp["labels"] = {**DEFAULT_LABELS, **(tp.get("labels") or {})}
    org = (tp.get("org") or "").strip()
    tp["team"] = f"a {org} team" if org else "a team"
    tp["internal"] = org or re.sub(r"[:：]\s*$", "", tp["labels"]["internal"]).strip() or "Internal"
    tp.setdefault("topic_style", "List Paragraph")
    return tp

def _unique_cells(row):
    out = []
    for ci, c in enumerate(row.cells):
        if not any(c._tc is o[1]._tc for o in out): out.append((ci, c))
    return out

def doc_outline(doc):
    lines = []
    for ti, t in enumerate(doc.tables):
        for ri, row in enumerate(t.rows):
            for ci, c in _unique_cells(row):
                lines.append(f"table {ti} row {ri} col {ci}: {c.text.strip()[:70]!r}")
    for i, p in enumerate(doc.paragraphs):
        if p.text.strip() or p.style.name not in ("Normal", "Body Text"):
            lines.append(f"paragraph {i} [{p.style.name}]: {p.text.strip()[:90]!r}")
    return "\n".join(lines)

LEARN_SCHEMA = {"type": "object", "required": ["org", "labels", "slots", "topic_style", "topic_heading"], "properties": {
    "org": {"type": "string"},
    "labels": {"type": "object", "properties": {k: {"type": "string"} for k in DEFAULT_LABELS}},
    "slots": {"type": "object", "properties": {k: {"type": "object", "required": ["table", "row", "col"], "properties": {
        "table": {"type": "integer"}, "row": {"type": "integer"}, "col": {"type": "integer"}}} for k in SLOTS}},
    "topic_style": {"type": "string"}, "topic_heading": {"type": "integer"}}}

LEARN_SYSTEM = """You study a Word template for minutes of meeting and say where each piece of information goes. Cells and paragraphs are listed as 'table T row R col C' or 'paragraph N [style]', with their current text (it may be example text from an old meeting).
Return JSON:
- org: the organisation the template belongs to (from labels such as 'Telkomsel:' or a company name in it), else "".
- labels: the template's own wording for: agenda (e.g. 'Meeting Agenda', 'Subject'), date, time, participants (the participants heading), internal (the heading above our own side's attendees), external (the heading above the other side's attendees, e.g. '3rd party', 'Guests'), topics (the heading above the discussion list, e.g. 'Topic Discussed:'). Copy the text exactly; use "" when absent.
- slots: the table cell where each VALUE is written (never the label cell): agenda, date, time, internal_names (cell listing our attendees, one per line), internal_unit (cell with their unit or team), external_names (the other side's attendees), external_company (their company). Use table, row, col exactly as listed. Leave a slot out if the template has no such place.
- topic_style: the paragraph style of the numbered discussion items (e.g. 'List Paragraph', 'List Number'), exactly as listed.
- topic_heading: the paragraph number of the heading above the discussion items, or -1."""

def _find_value_cell(doc, pattern):
    """Fallback: the cell to the right of a label cell that matches pattern."""
    for ti, t in enumerate(doc.tables):
        for ri, row in enumerate(t.rows):
            cells = _unique_cells(row)
            for k, (ci, c) in enumerate(cells[:-1]):
                if re.search(pattern, c.text.strip(), re.I) and len(c.text.strip()) < 40:
                    return [ti, ri, cells[k + 1][0]]
    return None

def _valid_slot(doc, rc, labels):
    try:
        t, r, c = rc
        cell = doc.tables[t].rows[r].cells[c]
        return cell.text.strip().rstrip(":").lower() not in {v.rstrip(":").lower() for v in labels.values() if v}
    except Exception:
        return False

def extract_logo(path: Path):
    """Pull the first picture (usually the logo) out of a docx and keep it as ~/.mom/logo.png for the preview."""
    import zipfile
    out = HOME / ".mom/logo.png"
    try:
        with zipfile.ZipFile(path) as z:
            media = sorted(n for n in z.namelist() if n.startswith("word/media/") and n.lower().rsplit(".", 1)[-1] in ("png", "jpg", "jpeg", "gif", "bmp", "tif", "tiff"))
            if not media: out.unlink(missing_ok=True); return None
            raw = HOME / ".mom/work" / ("logo_raw." + media[0].rsplit(".", 1)[-1]); raw.parent.mkdir(parents=True, exist_ok=True)
            raw.write_bytes(z.read(media[0]))
        r = run(["/usr/bin/sips", "-s", "format", "png", str(raw), "--out", str(out)])
        raw.unlink(missing_ok=True)
        return out if out.exists() else None
    except Exception as e:
        log("logo extract failed: " + repr(e)); return None

def learn_template(path: Path, install=True, org=""):
    """Read a user's Word template (with the local model), work out where each field goes, and remember it."""
    import docx
    doc = docx.Document(str(path))
    if not doc.tables and not doc.paragraphs: raise SystemExit("This Word file looks empty.")
    stage("Reading your template")
    raw = {}
    try:
        ensure_ollama()
        raw = json.loads(chat(LEARN_SYSTEM, doc_outline(doc), LEARN_SCHEMA))
    except (Exception, SystemExit) as e:
        log("template analysis by model failed, using label matching: " + repr(e))
    labels = {k: (raw.get("labels", {}).get(k) or "").strip() for k in DEFAULT_LABELS}
    slots = {}
    for k in SLOTS:
        s_ = (raw.get("slots") or {}).get(k)
        rc = [s_["table"], s_["row"], s_["col"]] if isinstance(s_, dict) and all(x in s_ for x in ("table", "row", "col")) else None
        if rc and not _valid_slot(doc, rc, labels): rc = None
        slots[k] = rc
    for k, pat in (("agenda", r"agenda|subject|topic of|title|meeting name|perihal|acara"), ("date", r"^(date|tanggal|hari)"), ("time", r"^(time|waktu|jam|pukul)")):
        if not slots.get(k): slots[k] = _find_value_cell(doc, pat)
    slots = {k: v for k, v in slots.items() if v}
    if not any(slots.get(k) for k in ("agenda", "date", "time")) and not doc.tables:
        log("no table found; fields other than the discussion will not be placed")
    styles = {p.style.name for p in doc.paragraphs}
    ts = raw.get("topic_style") if raw.get("topic_style") in styles else None
    items = [p for p in doc.paragraphs if p.style.name == (ts or "List Paragraph") and p.text.strip()]
    if not ts:
        ts = next((n for n in ("List Paragraph", "List Number", "List Bullet") if n in styles), "List Number")
    th = raw.get("topic_heading", -1)
    if not (isinstance(th, int) and 0 <= th < len(doc.paragraphs)):
        th = next((i for i, p in enumerate(doc.paragraphs) if re.search(r"topic|discuss|pembahasan|agenda pembicaraan", p.text, re.I) and len(p.text) < 60), -1)
    org = (org or raw.get("org") or "").strip()
    tp = {"name": path.stem, "org": org, "generic": False, "labels": labels, "map": {k: v for k, v in slots.items()},
          "topic_style": ts, "topic_heading": th, "has_examples": bool(items)}
    found = [k for k in SLOTS if k in slots]
    tp["found"] = found
    if install:
        if TEMPLATE.exists() and path.resolve() != TEMPLATE.resolve():
            shutil.copy2(TEMPLATE, HOME / ".mom/template.prev.docx")
        TEMPLATE.parent.mkdir(parents=True, exist_ok=True)
        if path.resolve() != TEMPLATE.resolve(): shutil.copy2(path, TEMPLATE)
        extract_logo(TEMPLATE)
        TPL_JSON.write_text(json.dumps(tp, ensure_ascii=False, indent=2))
    return tp

def make_generic_template(logo: Path = None, org: str = ""):
    """A clean, neutral Minutes of Meeting page with the user's logo (or organisation name) at the top."""
    import docx
    from docx.shared import Pt, Inches, RGBColor
    from docx.enum.text import WD_ALIGN_PARAGRAPH
    from docx.oxml.ns import qn
    from docx.oxml import OxmlElement
    doc = docx.Document()
    sec = doc.sections[0]
    sec.left_margin = sec.right_margin = Inches(0.9); sec.top_margin = Inches(0.8); sec.bottom_margin = Inches(0.8)
    base = doc.styles["Normal"]; base.font.name = "Calibri"; base.font.size = Pt(11)
    base.element.rPr.rFonts.set(qn("w:eastAsia"), "Calibri")
    ink, accent, mist = RGBColor(0x1D, 0x1D, 0x1F), "1F3A5F", "F2F4F7"
    head = doc.paragraphs[0] if doc.paragraphs else doc.add_paragraph()
    if logo and Path(logo).exists():
        head.add_run().add_picture(str(logo), height=Inches(0.55))
    elif org:
        r = head.add_run(org); r.bold = True; r.font.size = Pt(16); r.font.color.rgb = RGBColor(0x1F, 0x3A, 0x5F)
    head.paragraph_format.space_after = Pt(10)
    title = doc.add_paragraph(); title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r = title.add_run("MINUTES OF MEETING"); r.bold = True; r.font.size = Pt(15); r.font.color.rgb = ink
    title.paragraph_format.space_after = Pt(10)

    def shade(cell, fill):
        pr = cell._tc.get_or_add_tcPr(); sh_ = OxmlElement("w:shd")
        sh_.set(qn("w:val"), "clear"); sh_.set(qn("w:color"), "auto"); sh_.set(qn("w:fill"), fill); pr.append(sh_)
    def borders(table, color="C9CED6"):
        pr = table._tbl.tblPr; b = OxmlElement("w:tblBorders")
        for edge in ("top", "left", "bottom", "right", "insideH", "insideV"):
            e = OxmlElement(f"w:{edge}"); e.set(qn("w:val"), "single"); e.set(qn("w:sz"), "4"); e.set(qn("w:space"), "0"); e.set(qn("w:color"), color); b.append(e)
        pr.append(b)
    def pad(table):
        pr = table._tbl.tblPr; m = OxmlElement("w:tblCellMar")
        for edge, v in (("top", 70), ("left", 110), ("bottom", 70), ("right", 110)):
            e = OxmlElement(f"w:{edge}"); e.set(qn("w:w"), str(v)); e.set(qn("w:type"), "dxa"); m.append(e)
        pr.append(m)
    def put(cell, text, bold=False, color=None, size=11):
        cell.text = ""; p = cell.paragraphs[0]; p.paragraph_format.space_after = Pt(0)
        r_ = p.add_run(text); r_.bold = bold; r_.font.size = Pt(size)
        if color: r_.font.color.rgb = color

    t = doc.add_table(rows=8, cols=4); borders(t); pad(t); t.autofit = False
    widths = [Inches(1.5), Inches(1.9), Inches(1.7), Inches(1.6)]
    for row in t.rows:
        for i, c in enumerate(row.cells): c.width = widths[i]
    for ri, label in enumerate(("Meeting Agenda", "Date", "Time")):
        put(t.rows[ri].cells[0], label, bold=True); shade(t.rows[ri].cells[0], mist)
        t.rows[ri].cells[1].merge(t.rows[ri].cells[3])
