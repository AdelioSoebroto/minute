            "brew": bool(BREW), "items": items}

def _stream(cmd, label, env=None):
    """Run a command, turning its progress output into STAGE lines the app shows."""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env or os.environ)
    last = ""
    buf = b""
    while True:
        ch = p.stdout.read(1)
        if not ch: break
        if ch in (b"\r", b"\n"):
            t = buf.decode("utf-8", "ignore").strip(); buf = b""
            m_ = re.search(r"(\d{1,3})\s*%", t)
            if m_ and m_.group(1) != last: last = m_.group(1); stage(f"{label} {last}%")
        else: buf += ch
    return p.wait()

def get_whisper():
    dst = Path(CFG["whisper_model"]); dst.parent.mkdir(parents=True, exist_ok=True)
    part = dst.with_suffix(".part")
    opener = urllib.request.build_opener()       # unlike the rest of Minute, this one may use the system proxy: it is the one thing that needs the internet
    last = -1
    with opener.open(WHISPER_URL, timeout=60) as r, open(part, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0); got = 0
        while True:
            b = r.read(1 << 20)
            if not b: break
            f.write(b); got += len(b)
            pc = int(got * 100 / total) if total else 0
            if pc != last: last = pc; stage(f"Downloading the speech model {pc}%")
    if part.stat().st_size < 400_000_000: part.unlink(missing_ok=True); raise SystemExit("The download was incomplete. Check the connection and try again.")
    part.rename(dst); print("DONE", flush=True)

def install_tools():
    if not BREW: raise SystemExit("Homebrew is not installed. Install it from brew.sh, then try again.")
    need = [pkg for pkg, ok in (("whisper-cpp", shutil.which("whisper-cli")), ("ffmpeg", shutil.which("ffmpeg")), ("ollama", shutil.which("ollama"))) if not ok]
    for pkg in need:
        stage(f"Installing {pkg}")
        if _stream([BREW, "install", pkg], f"Installing {pkg}", {**os.environ, "HOMEBREW_NO_AUTO_UPDATE": "1", "HOMEBREW_NO_ENV_HINTS": "1"}):
            raise SystemExit(f"Could not install {pkg}.")
    print("DONE", flush=True)

# ---------- context beyond the audio: calendar event and what was shown on screen ----------
def load_json(p, default):
    try: return json.loads(Path(p).read_text())
    except Exception: return default

def screen_events(session: Path):
    return [e for e in load_json(session / "screens.json", []) if isinstance(e, dict) and (e.get("text") or "").strip()]

def marks_block(session: Path):
    """Moments the user flagged live (action / decision / important), with what was said in the half minute before each."""
    marks = [m for m in load_json(session / "marks.json", []) if isinstance(m, dict) and isinstance(m.get("t"), (int, float))]
    if not marks: return ""
    lines = []
    try:
        for raw in (session / "transcript.md").read_text().splitlines():
            m = re.match(r"\[(\d+):(\d+):(\d+)\]\s*([^:]+):\s*(.*)", raw)
            if m: lines.append((int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3]), m[4].strip(), m[5].strip()))
    except Exception: pass
    out = []
    for mk in sorted(marks, key=lambda x: x["t"])[:40]:
        near = " ".join(f"{who}: {txt}" for t, who, txt in lines if mk["t"] - 30 <= t <= mk["t"] + 3)[:500]
        out.append(f"[{ts(mk['t'])}] {str(mk.get('kind', 'important')).upper()}" + (f" - just said: \"{near}\"" if near else ""))
    return ("FLAGS THE USER DROPPED DURING THE MEETING (the point being discussed right before each flag matters most): " + " | ".join(out) +
            ". Every ACTION flag must appear as an action item with its owner and due date, every DECISION flag as a decision, and every IMPORTANT flag in the topics.")

def context_block(session: Path, limit=2600):
    """Extra facts for the writing prompts: the calendar entry the meeting was recorded for, and text that was on screen (slides, documents) with times."""
    parts = []
    cal = load_json(session / "meeting.json", {})
    if cal.get("title"): parts.append(f"CALENDAR EVENT: \"{cal['title']}\"" + (f"; invited: {', '.join(cal.get('attendees', [])[:25])}" if cal.get("attendees") else "")
                                      + ". Use the title for the agenda if it fits what was discussed; the invited names are spelling references, not proof of attendance.")
    ev = screen_events(session)
    if ev:
        used, lines = 0, []
        for e in ev:
            t = re.sub(r"\s+", " ", e["text"]).strip()[:420]
            line = f"[{ts(e.get('t', 0))}] {t}"
            if used + len(line) > limit: break
            lines.append(line); used += len(line)
        parts.append("TEXT SHOWN ON SCREEN DURING THE MEETING (slides or documents, with times; use it to spell names, products and numbers right and to understand what 'ini', 'yang ini' or 'this' refers to; do not copy it wholesale): " + " | ".join(lines))
    mb = marks_block(session)
    if mb: parts.append(mb)
    return "\n".join(parts)

def screen_terms(session: Path):
    """Distinctive words from on-screen text, offered to the name fixer as spelling references."""
    words = {}
    for e in screen_events(session):
        for w in re.findall(r"\b[A-Z][A-Za-z0-9]{2,}\b|\b[A-Z]{2,6}\b", e["text"]): words[w] = words.get(w, 0) + 1
    return [w for w, _ in sorted(words.items(), key=lambda kv: -kv[1])[:60]]

def whisper_prompt():
    terms = ", ".join(glossary()[-40:])
    base = ("Meeting in English and Bahasa Indonesia, formal and casual, switching between them. "
            "Obrolan santai dan formal: gue, lo, nggak, udah, banget, sih, dong, deh, kok, wkwk, deploy, follow up, approval. "
            "Acronyms: CTR, KPI, SLA, API, SSL, VPN, UAT, PIC, MoM. Transcribe exactly as spoken, keep slang and English words as said.")
    return (base + (f" Terms: {terms}." if terms else ""))[:700]

def collapse_loops(t: str) -> str:
    """Whisper sometimes loops ('in the chat box in the chat box ...'). Keep one copy of the repeated phrase and the rest of the text."""
    w = t.split()
    for n in (2, 3, 4, 5, 6):
        i = 0
        while i + 3 * n <= len(w):
            if w[i:i + n] == w[i + n:i + 2 * n] == w[i + 2 * n:i + 3 * n]:
                j = i + 3 * n
                while w[j:j + n] == w[i:i + n]: j += n
                return collapse_loops(" ".join(w[:i + n] + w[j:]))
            i += 1
    return t

HALLU = re.compile(r"^(thanks? for watching|thank you\.?|terima kasih\.?|subtitles? by.*|\W*)$", re.I)
# things Whisper invents from silence or noise (training-data credits and calls to action, in many languages)
HALLU_ANY = re.compile(r"sous-titr|société radio|radio-canada|amara\.org|subtitles? (by|from)|untertitel|ondertitel|sottotitoli|legendas? |"
                       r"thanks? for watching|thank you for watching|terima kasih (telah|sudah|atas) (menonton|tontonan)|please subscribe|like and subscribe|"
                       r"subscribe to|jangan lupa (subscribe|like)|www\.|\.com\b|♪|\[(music|musik|applause|tepuk tangan)\]", re.I)

def drop_hallucinations(segs):
    """Remove text Whisper made up from quiet noise: known credit lines, and short lines repeated again and again on one track."""
    from collections import Counter
    segs = [x for x in segs if not HALLU_ANY.search(x[2])]
    norm = lambda t: re.sub(r"\W+", " ", t.lower()).strip()
    cnt = Counter((x[1], norm(x[2])) for x in segs)
    out = []
    for x in segs:
        if 4 <= len(x[2].split()) <= 12 and cnt[(x[1], norm(x[2]))] >= 3:
            log("dropped repeated line: " + x[2]); continue
        out.append(x)
    return out

def whisper(chunk: Path, lang: str):
    out = chunk.with_suffix("")
    cmd = ["whisper-cli", "-m", CFG["whisper_model"], "-f", str(chunk), "-l", lang, "-oj", "-of", str(out),
           "--prompt", whisper_prompt(), "--suppress-nst",
           "-bs", str(profile()["beam"]), "-bo", str(profile()["beam"]), "-t", str(profile()["threads"])]
    r = run(cmd)
    if r.returncode: raise SystemExit("whisper failed: " + r.stderr[-300:])
    return json.loads(Path(str(out) + ".json").read_text())

def transcribe(label, wav, tmp, total_done, n_total):
    total = duration(wav)
    cuts = cut_points(wav, total)
    segs = []
    for i in range(len(cuts) - 1):
        a, b = cuts[i], cuts[i + 1]
        stage(f"Transcribing {label}: {int(a // 60)} of {max(1, round(total / 60))} min")
        if b - a < 0.8 or mean_volume(wav, a, b) < (-45 if label == "Others" else -50): continue
        ch = tmp / f"{label}_{i:04d}.wav"
        run(["ffmpeg", "-y", "-ss", str(a), "-t", str(b - a), "-i", str(wav), "-c", "copy", str(ch)])
        runs = [[a + x, a + y] for x, y in speech_runs(ch)]
        j = whisper(ch, "auto")
        if j.get("result", {}).get("language") not in ("en", "id"):
            j = whisper(ch, "id")
        floor = a
        for s in j.get("transcription", []):
            t = collapse_loops(s["text"].strip())
            if not t or HALLU.match(t): continue
            sf, st = align_to_speech(a + s["offsets"]["from"] / 1000, a + s["offsets"]["to"] / 1000, runs, floor)
            floor = st
            segs += split_lines(sf, st, label, t, runs=runs)
    return segs

def speech_runs(wav_path, thr_ratio=0.12):
    """Stretches of actual speech (start, end) in seconds within a wav, from its loudness, so lines are timed by when words were spoken and not spread over silence."""
    import wave, audioop
    try:
        w = wave.open(str(wav_path)); n = int(w.getframerate() * 0.1); rms = []
        while True:
            b = w.readframes(n)
            if not b: break
            rms.append(audioop.rms(b, 2))
    except Exception:
        return []
    if not rms: return []
    thr = max(200, sorted(rms)[int(len(rms) * 0.9)] * thr_ratio)
    runs, start = [], None
    for i, v in enumerate(rms):
        if v >= thr and start is None: start = i
        if v < thr and start is not None: runs.append([start * 0.1, i * 0.1]); start = None
    if start is not None: runs.append([start * 0.1, len(rms) * 0.1])
    merged = []
    for r in runs:
        if merged and r[0] - merged[-1][1] < 0.6: merged[-1][1] = r[1]
        else: merged.append(r)
    return merged

def _at_speech_fraction(runs, frac):
    """Wall-clock time at which `frac` of the speech in `runs` has been spoken."""
    total = sum(b - a for a, b in runs)
    if total <= 0: return runs[0][0]
    target = frac * total
    for a, b in runs:
        if target <= b - a: return a + target
        target -= b - a
    return runs[-1][1]

def align_to_speech(sf, st, runs, floor=0.0):
    """Whisper's timestamps are unreliable around silence (it can place a sentence right after the previous one even though it was spoken much later).
    If a segment overlaps no speech but speech comes later, move it to the next stretch of real speech."""
    if not runs: return sf, st
    if any(min(st, b) - max(sf, a) >= 0.5 for a, b in runs): return sf, st
    nxt = next((r for r in runs if r[0] >= floor - 0.3 and r[1] > sf), None)
    return (nxt[0], nxt[1]) if nxt else (sf, st)

def split_lines(start, end, label, text, maxlen=170, runs=None):
    """Whisper returns long blocks; cut them at sentence ends into caption-sized lines and time each by when it was actually spoken (runs = speech stretches, absolute seconds)."""
    parts = [x for x in re.split(r"(?<=[.!?…])\s+", text) if x]
    groups, cur = [], ""
    for x in parts:
        if cur and len(cur) + 1 + len(x) > maxlen: groups.append(cur); cur = x
        else: cur = (cur + " " + x).strip()
    if cur: groups.append(cur)
    clipped = [[max(a, start), min(b, end)] for a, b in (runs or []) if b > start and a < end]
    clipped = [r for r in clipped if r[1] > r[0]]
    long_enough = [r for r in clipped if r[1] - r[0] >= 0.5]
    clipped = long_enough or clipped          # the tail of the previous utterance that Whisper's window touches is not this sentence
    total = max(1, sum(len(g) for g in groups)); done = 0; out = []
    speech = sum(b - a for a, b in clipped)
    bounds, acc = [], 0.0                       # speech seconds elapsed when each stretch ends, and where the next one starts
    for k in range(len(clipped) - 1):
        acc += clipped[k][1] - clipped[k][0]; bounds.append((acc, clipped[k + 1][0]))
    prev_len = 0.0
    for g in groups:
        if not clipped: t = start + (end - start) * done / total
        else:
            x = done / total * speech
            t = _at_speech_fraction(clipped, done / total)
            near = min(bounds, key=lambda bd: abs(bd[0] - x), default=None)
            if near and done and abs(near[0] - x) <= max(0.8, 0.5 * prev_len): t = near[1]      # a new sentence usually starts after a pause: snap to it
        out.append((t, label, g)); done += len(g); prev_len = speech * len(g) / total
    return out

def drop_echo(segs):
    """When the meeting plays through speakers the mic hears it too: drop 'Me' lines that repeat a nearby 'Others' line."""
    import difflib
    others = [x for x in segs if x[1] == "Others"]
    if not others: return segs
    keep = []
    for x in segs:
        if x[1] == "Me" and any(abs(o[0] - x[0]) <= 5 and difflib.SequenceMatcher(None, x[2].lower(), o[2].lower()).ratio() >= 0.6 for o in others):
            log("dropped echo: " + x[2]); continue
        keep.append(x)
    return keep

def suppress_bleed(mic: Path, system: Path, out: Path):
    """When the meeting plays through speakers the mic hears it too. Using the exact meeting audio as a reference, silence the
    mic wherever it is only picking up that bleed (not the user's own, much louder, voice). Both files: 16 kHz mono 16-bit WAV."""
    import audioop, wave
    with wave.open(str(mic)) as a, wave.open(str(system)) as b:
        ma, sb = a.readframes(a.getnframes()), b.readframes(b.getnframes())
    n = 1600                                  # 0.1 s frames
    fa = [ma[i:i + 2 * n] for i in range(0, len(ma), 2 * n)]
    fb = [sb[i:i + 2 * n] for i in range(0, len(sb), 2 * n)]
    m = min(len(fa), len(fb))
    ra = [audioop.rms(f, 2) for f in fa[:m]]; rb = [audioop.rms(f, 2) for f in fb[:m]]
    loud = [i for i in range(m) if rb[i] > 400]
    if len(loud) < 20: shutil.copy(mic, out); return 0
    ratios = sorted(ra[i] / rb[i] for i in loud)
    g = ratios[len(ratios) // 3]              # typical bleed gain: the lower third, i.e. frames where only the speakers are heard
    muted, parts = 0, []
    for i in range(len(fa)):
        f = fa[i]
        # bleed-only frames: meeting audio present and the mic is not much louder than the bleed we would expect
        if i < m and rb[i] > 400 and ra[i] < 2.5 * g * rb[i] + 150: f = b"\x00" * len(f); muted += 1
        parts.append(f)
    with wave.open(str(out), "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000); w.writeframes(b"".join(parts))
    log(f"bleed suppression: gain {g:.2f}, muted {muted} of {len(fa)} frames")
    return muted

def ts(sec): return f"{int(sec // 3600):02d}:{int(sec % 3600 // 60):02d}:{int(sec % 60):02d}"

