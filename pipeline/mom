bakal = akan; kudu = harus; abis = setelah / habis; ntar/entar = nanti; bentar = sebentar; trus/terus = lalu; kayak/kek = seperti;
doang = saja; emang/emg = memang; gimana/gmn = bagaimana; kenapa/knp = mengapa; makanya = oleh karena itu; soalnya = karena;
sih/deh/dong/kok/lah/nih/tuh/kan/yah/loh = penegas, abaikan; wkwk/haha = tawa; mantap/sip/siap = setuju / dimengerti; gas = lanjutkan;
acc = setuju / approve; otw = sedang menuju / dalam proses; asap = secepatnya; pic = penanggung jawab; eskalasi = naikkan ke atasan;
ngecek = memeriksa; nge-push = mengunggah; di-follow up = ditindaklanjuti; ngebahas = membahas; ngurusin = menangani; ngomongin = membicarakan;
mepet = sempit waktunya; molor = tertunda; kelar = selesai; rampung = selesai; kendala = masalah; ketemu = bertemu / ditemukan;
nanya = bertanya; minta tolong = permintaan bantuan; mas/mbak/bang/kak/pak/bu = sapaan hormat; oke/ok/sip = baik;
besok = hari berikutnya; lusa = dua hari lagi; minggu depan = minggu setelah ini; hari ini/tadi/kemarin = relatif terhadap tanggal rapat"""

def slang_lines():
    extra = HOME / ".mom/slang.txt"
    return SLANG + ("\n" + extra.read_text() if extra.exists() else "")

GLOSS = HOME / ".mom/glossary.txt"
def glossary():
    return [l.strip() for l in GLOSS.read_text().splitlines() if l.strip()] if GLOSS.exists() else []

def learn_terms(data):
    """Remember names and companies from finalised minutes so later transcripts spell them right."""
    new = [*data.get("telkomsel_names", []), *data.get("third_party_names", []), data.get("telkomsel_unit", ""), data.get("third_party_company", "")]
    have = glossary(); low = {h.lower() for h in have}
    add = [n for n in new if n and n.lower() not in low]
    if add: GLOSS.write_text("\n".join(have + add) + "\n")

# ---------- names the transcript must spell right: built-in Indonesian lexicon + the user's own terms + corrections learned from their edits ----------
USER_TERMS = HOME / ".mom/terms.txt"             # the user's own brands/names; plain lines, or "heard = correct"
LEARNED = HOME / ".mom/corrections.txt"          # filled automatically from the user's transcript edits

def _term_files():
    here = Path(__file__).resolve().parent
    return [p for p in (here / "lexicon_id.txt", HOME / ".mom/lexicon_id.txt", USER_TERMS) if p.exists()]

def lexicon():
    seen, out = set(), []
    for f in _term_files():
        for l in f.read_text().splitlines():
            l = l.strip()
            if not l or l.startswith("#") or "=" in l: continue
            if l.lower() not in seen: seen.add(l.lower()); out.append(l)
    return out

def corrections():
    """heard -> correct, from the user's terms file and from edits they made to earlier transcripts."""
    out = {}
    for f in (USER_TERMS, LEARNED):
        if not f.exists(): continue
        for l in f.read_text().splitlines():
            if "=" in l and not l.strip().startswith("#"):
                a, b = (x.strip() for x in l.split("=", 1))
                if a and b: out[a] = b
    return out

def apply_corrections(text, mapping=None):
    mapping = corrections() if mapping is None else mapping
    for heard in sorted(mapping, key=len, reverse=True):
        flags = re.I if len(heard) >= 4 else 0       # short acronyms (TZ) only match as typed
        text = re.sub(r"(?<!\w)" + re.escape(heard) + r"(?!\w)", mapping[heard].replace("\\", "\\\\"), text, flags=flags)
    return text

TERMS_SCHEMA = {"type": "object", "required": ["replacements"], "properties": {"replacements": {"type": "array", "items": {
    "type": "object", "required": ["heard", "correct"], "properties": {"heard": {"type": "string"}, "correct": {"type": "string"}}}}}}

def fix_terms(transcript, extra=None):
    """Ask the local model which words in the transcript are misheard brands, restaurants or places from the lexicon; apply only safe, verbatim swaps."""
    lex = lexicon()
    if not lex: return transcript
    stage("Checking names and brands")
    out = json.loads(chat(
        "You fix misheard proper nouns in a speech-to-text transcript that mixes English and Bahasa Indonesia (formal and slang). You get a list of KNOWN NAMES: brands, restaurants, shops, apps, banks, places, institutions and work terms common in Indonesia. "
        "Return the replacements needed where a word or short phrase in the transcript is clearly a misheard or misspelled version of a known name, judged by how it sounds and by the context (for example 'TZ' or 'tizi' said about a tea drink means 'Teazzi'; 'indo maret' means 'Indomaret'; 'tokped' is slang, leave it). "
        "'heard' must appear in the transcript exactly as written. 'correct' must be copied exactly from the list. Do not touch ordinary words, people's names, or anything you are not sure about. Return an empty list if nothing needs fixing.",
        "KNOWN NAMES: " + "; ".join(lex)[:4500] + ("\nALSO SEEN ON SCREEN DURING THE MEETING (treat as known names too): " + "; ".join(extra) if extra else "") + "\n\nTRANSCRIPT:\n" + transcript, TERMS_SCHEMA))
    canon = {x.lower(): x for x in lex + list(extra or [])}
    pairs = {}
    for r in out.get("replacements", [])[:12]:
        h, c = (r.get("heard") or "").strip(), canon.get((r.get("correct") or "").strip().lower())
        if c and len(h) >= 2 and h != c and re.search(r"(?<!\w)" + re.escape(h) + r"(?!\w)", transcript): pairs[h] = c
    if pairs: log("name fixes: " + json.dumps(pairs, ensure_ascii=False))
    return apply_corrections(transcript, pairs) if pairs else transcript

SEEN = HOME / ".mom/seen_terms.json"

def harvest_terms(d: Path):
    """Passive learning: a capitalised word or acronym that shows up in two different meetings is probably a real name, product or term of this user's world.
    Remember it so Whisper is nudged toward it and the minutes spell it the same way every time."""
    f = d / "transcript.md"
    if not f.exists(): return
    text = re.sub(r"^# Transcript\s*", "", f.read_text())
    body = "\n".join(re.sub(r"^\[[\d:]+\] [^:]+: ", "", l) for l in text.splitlines())
    lower = set(re.findall(r"\b[a-z][a-z']+\b", body))
    calendar_words = {x.lower() for x in HARI + BULAN + ["January", "February", "March", "April", "May", "June", "July", "August", "October", "December", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]}
    cands = set()
    for m_ in re.finditer(r"(?<![.!?]\s)(?<!^)\b([A-Z][A-Za-z0-9]{2,}|[A-Z]{2,6})\b", body, re.M):
        w = m_.group(1)
        if w.lower() in lower or w.lower() in calendar_words or w.lower() in {x.lower() for x in lexicon()}: continue     # an ordinary word, or already known
        cands.add(w)
    if not cands: return
    try: seen = json.loads(SEEN.read_text())
    except Exception: seen = {}
    for w in cands:
        if d.name not in seen.setdefault(w, []): seen[w].append(d.name)
    SEEN.parent.mkdir(parents=True, exist_ok=True); SEEN.write_text(json.dumps(seen, ensure_ascii=False, indent=1))
    have = {g.lower() for g in glossary()}
    add = [w for w, ms in seen.items() if len(ms) >= 2 and w.lower() not in have]
    if add:
        GLOSS.write_text("\n".join(glossary() + add) + "\n"); log("learned terms: " + ", ".join(add))

def learn_from_edits(d: Path):
    """Compare the transcript as heard with what the user corrected it to; remember word swaps so the next transcript gets them right."""
    import difflib
    orig, cur = d / "transcript.orig.md", d / "transcript.md"
    if not orig.exists() or not cur.exists(): return
    def lines(f):
        out = {}
        for l in f.read_text().splitlines():
            m = re.match(r"(\[[\d:]+\] [^:]+): (.*)", l)
            if m: out[m.group(1)] = m.group(2)
        return out
    a, b = lines(orig), lines(cur)
    strip = lambda w: w.strip(".,;:!?\"'()[]")
    known = corrections(); new = {}
    for k, old in a.items():
        if k not in b or b[k] == old: continue
        ow, nw = old.split(), b[k].split()
        for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, ow, nw, autojunk=False).get_opcodes():
            if op != "replace" or i2 - i1 > 2 or j2 - j1 > 2: continue
            heard, correct = strip(" ".join(ow[i1:i2])), strip(" ".join(nw[j1:j2]))
            if len(heard) < 2 or not correct or heard.lower() == correct.lower() or heard.isdigit() or correct.isdigit(): continue
            if heard not in known: new[heard] = correct
    if new:
        with open(LEARNED, "a") as f:
            for h, c in list(new.items())[:20]: f.write(f"{h} = {c}\n")
        have = {g.lower() for g in glossary()}
        add = [c for c in new.values() if c.lower() not in have]
        if add: GLOSS.write_text("\n".join(glossary() + add) + "\n")
        log("learned corrections: " + json.dumps(new, ensure_ascii=False))
    orig.write_text(cur.read_text())

