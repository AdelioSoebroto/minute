HARI = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"]
BULAN = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]

def fix_weekday_dates(text: str, day0, said_days=None):
    """Language models get 'next Friday' wrong. Recompute any 'Jumat, 21 Oktober 2026' so the weekday and the date agree (next occurrence after the meeting)."""
    import datetime
    pat = re.compile(r"\b(" + "|".join(HARI) + r")(,?\s*\(?)(\d{1,2})\s+(" + "|".join(BULAN) + r")\s+(\d{4})", re.I)
    def sub(m):
        wd = [h.lower() for h in HARI].index(m.group(1).lower())
        try: said = datetime.date(int(m.group(5)), [b.lower() for b in BULAN].index(m.group(4).lower()) + 1, int(m.group(3)))
        except ValueError: said = None
        if said and said >= day0 and said.weekday() == wd: return m.group(0)        # already consistent
        if said and said_days is not None and HARI[wd].lower() not in said_days and 0 <= (said - day0).days <= 14:
            return f"{HARI[said.weekday()]}{m.group(2)}{said.day} {BULAN[said.month - 1]} {said.year}"   # weekday never said aloud: trust the date, fix the weekday
        k = next(k for k in range(1, 8) if (day0 + datetime.timedelta(days=k)).weekday() == wd)
        d = day0 + datetime.timedelta(days=k)
        return f"{m.group(1)}{m.group(2)}{d.day} {BULAN[d.month - 1]} {d.year}"
    return pat.sub(sub, text)

EN_DAYS = {"monday": 0, "tuesday": 1, "wednesday": 2, "thursday": 3, "friday": 4, "saturday": 5, "sunday": 6}

def annotate_dates(text: str, day0) -> str:
    """Spell out relative dates next to the words that say them, so even a small model gets 'besok', 'Jumat' or 'next week' right."""
    import datetime
    def fmt(d): return f"{HARI[d.weekday()]} {d.day} {BULAN[d.month - 1]} {d.year}"
    def nxt(wd):
        return day0 + datetime.timedelta(days=next(k for k in range(1, 8) if (day0 + datetime.timedelta(days=k)).weekday() == wd))
    rel = {r"besok": 1, r"tomorrow": 1, r"lusa": 2, r"hari ini": 0, r"today": 0, r"kemarin": -1, r"yesterday": -1}
    for w, k in rel.items():
        text = re.sub(rf"\b({w})\b(?!\s*\[)", lambda m, k=k: f"{m.group(1)} [{fmt(day0 + datetime.timedelta(days=k))}]", text, flags=re.I)
    wk = day0 - datetime.timedelta(days=day0.weekday()) + datetime.timedelta(days=7)      # Monday of next week
    for i, h in enumerate(HARI):   # "Rabu depan" = that weekday of next week
        if h == "Minggu": continue
        text = re.sub(rf"\b({h}\s+depan)\b(?!\s*\[)", lambda m, i=i: f"{m.group(1)} [{fmt(wk + datetime.timedelta(days=i))}]", text, flags=re.I)
    for e, i in EN_DAYS.items():
        text = re.sub(rf"\b(next\s+{e})\b(?!\s*\[)", lambda m, i=i: f"{m.group(1)} [{fmt(wk + datetime.timedelta(days=i))}]", text, flags=re.I)
    for i, h in enumerate(HARI):
        if h == "Minggu":   # 'minggu' also means 'week' (dua minggu, mingguan): only treat it as Sunday after 'hari'
            text = re.sub(r"(?<!setiap )(?<!tiap )\b(hari\s+minggu)\b(?!\s*,?\s*[\[\d])", lambda m: f"{m.group(1)} [{fmt(nxt(6))}]", text, flags=re.I)
            continue
        text = re.sub(rf"(?<!setiap )(?<!tiap )(?<!every )(?<!each )\b(hari\s+)?({h})\b(?!\s*,?\s*[\[\d])(?!\s+depan)", lambda m, i=i: f"{m.group(0)} [{fmt(nxt(i))}]", text, flags=re.I)
    for e, i in EN_DAYS.items():
        text = re.sub(rf"(?<!every )(?<!each )(?<!next )\b({e})\b(?!\s*\[)", lambda m, i=i: f"{m.group(1)} [{fmt(nxt(i))}]", text, flags=re.I)
    text = re.sub(r"\b(minggu depan|next week)\b", lambda m: f"{m.group(1)} [week of {fmt(day0 + datetime.timedelta(days=7 - day0.weekday()))}]", text, flags=re.I)
    return text

def drop_unsupported_dates(topics, annotated_transcript, day0):
    """A small model sometimes invents a date. Keep an exact date in the minutes only if the meeting (or the calendar words said in it) supports it."""
    import datetime
    allowed = {(day0.day, day0.month)}
    for m in re.finditer(r"(\d{1,2})\s+(" + "|".join(BULAN) + r")", annotated_transcript, re.I):
        allowed.add((int(m.group(1)), [b.lower() for b in BULAN].index(m.group(2).lower()) + 1))
    pat = re.compile(r"\b((?:" + "|".join(HARI) + r"),?\s+)?(\d{1,2})\s+(" + "|".join(BULAN) + r")(\s+\d{4})?", re.I)
    def sub(m):
        key = (int(m.group(2)), [b.lower() for b in BULAN].index(m.group(3).lower()) + 1)
        if key in allowed: return m.group(0)
        return (m.group(1) or "").strip(" ,") if m.group(1) else m.group(0)   # unsupported weekday+date: keep only the weekday
    return [pat.sub(sub, t) for t in topics]

MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
