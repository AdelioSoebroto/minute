#!/usr/bin/env python3
"""mom <session-folder | audio-file> : transcribe on-device (whisper.cpp) and write a MoM (local LLM via Ollama).

A session folder holds mic.caf (you) and optionally system.caf (the other participants).
Any single audio/video file also works; it is treated as one track.
Outputs next to the audio: transcript.md, MoM.md, MoM.docx.
Config: ~/.mom/config.json (optional), template: ~/.mom/template.md
"""
import json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request
from pathlib import Path

HOME = Path.home()
CFG = {"whisper_model": str(HOME / ".mom/models/ggml-large-v3-turbo.bin"),
       "llm": "qwen3:14b", "mom_language": "auto", "ctx": 32768,
       "keep_audio": True, "title": "", "my_name": "Adelio Ferhan", "my_unit": "IT Digital Advertising Management"}
cfgp = HOME / ".mom/config.json"
if cfgp.exists():
    CFG.update(json.loads(cfgp.read_text()))
# Everything runs on this Mac and never needs the internet. Talk to Ollama directly even if a VPN or proxy is configured.
urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:" + os.environ.get("PATH", "")

LOGF = None
def log(msg):
    if LOGF:
        with open(LOGF, "a") as f: f.write(time.strftime("%H:%M:%S ") + str(msg) + "\n")
def stage(s): log("STAGE " + s); print(f"STAGE: {s}", flush=True)
def run(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)

def prepare(arg: Path):
    """Returns (session_dir, [(label, audio_path)])"""
    if arg.is_dir():
        tracks = []
        mode = (arg / "mode.txt").read_text().strip() if (arg / "mode.txt").exists() else ""
        for name, label in (("mic", "Me" if mode == "Online" else "Speaker"), ("system", "Others")):
            # the app starts a new segment (mic_2.caf ...) when the audio device changes mid-meeting
            parts = sorted((p for p in arg.glob(f"{name}*.caf") if p.stat().st_size > 4096),
                           key=lambda p: int(p.stem.rsplit("_", 1)[1]) if "_" in p.stem else 1)
            if not parts:
                for ext in ("wav", "m4a", "mp3"):
                    parts = [p for p in [arg / f"{name}.{ext}"] if p.exists()]
                    if parts: break
            if parts: tracks.append((label, parts))
        return arg, tracks
    d = HOME / "Documents/MoM" / (time.strftime("%Y-%m-%d_%H%M_") + re.sub(r"\W+", "-", arg.stem)[:40])
    d.mkdir(parents=True, exist_ok=True)
    shutil.copy2(arg, d / arg.name)
    return d, [("Speaker", [d / arg.name])]

def to_wav(srcs, dst: Path):
    wavs = []
    for i, src in enumerate(srcs):
        w = dst.with_name(f"{dst.stem}_seg{i}.wav")
        r = run(["ffmpeg", "-y", "-i", str(src), "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", str(w)])
        if r.returncode: raise SystemExit(f"ffmpeg failed on {src.name}: {r.stderr[-300:]}")
        wavs.append(w)
    if len(wavs) == 1: wavs[0].rename(dst); return
    lst = dst.with_suffix(".txt"); lst.write_text("".join(f"file '{w}'\n" for w in wavs))
    r = run(["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy", str(dst)])
    if r.returncode: raise SystemExit("ffmpeg concat failed: " + r.stderr[-300:])

def duration(p: Path):
    r = run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(p)])
    return float(r.stdout.strip() or 0)

def cut_points(wav: Path, total: float):
    """Chunk boundaries (seconds) placed in silences so words are not split. Chunks are 30-70 s."""
    r = run(["ffmpeg", "-i", str(wav), "-af", "silencedetect=noise=-35dB:d=0.35", "-f", "null", "-"])
    mids, start = [], None
    for line in r.stderr.splitlines():
        m = re.search(r"silence_start: ([\d.]+)", line)
        if m: start = float(m.group(1))
        m = re.search(r"silence_end: ([\d.]+)", line)
        if m and start is not None: mids.append((start + float(m.group(1))) / 2); start = None
    cuts, last = [0.0], 0.0
    while total - last > 70:
        cand = [t for t in mids if last + 30 <= t <= last + 70]
        nxt = cand[0] if cand else last + 60
        cuts.append(nxt); last = nxt
    cuts.append(total)
    return cuts

def mean_volume(wav, a, b):
    r = run(["ffmpeg", "-ss", str(a), "-t", str(b - a), "-i", str(wav), "-af", "volumedetect", "-f", "null", "-"])
    m = re.search(r"mean_volume: (-?[\d.]+)", r.stderr)
    return float(m.group(1)) if m else -91.0

# Informal Indonesian / Jaksel-style code-switching and office slang. The transcriber is told to keep these as spoken,
# and the drafter uses the meanings to understand them. Add your own lines ("said = meaning") to ~/.mom/slang.txt.
SLANG = """gue/gw/gua = saya; lo/lu/elu = kamu; nggak/gak/ga/enggak/engga = tidak; udah/dah = sudah; belom = belum; banget/bgt = sekali;
bakal = akan; kudu = harus; abis = setelah / habis; ntar/entar = nanti; bentar = sebentar; trus/terus = lalu; kayak/kek = seperti;
doang = saja; emang/emg = memang; gimana/gmn = bagaimana; kenapa/knp = mengapa; makanya = oleh karena itu; soalnya = karena;
sih/deh/dong/kok/lah/nih/tuh/kan/yah/loh = penegas, abaikan; wkwk/haha = tawa; mantap/sip/siap = setuju / dimengerti; gas = lanjutkan;
acc = setuju / approve; otw = sedang menuju / dalam proses; asap = secepatnya; pic = penanggung jawab; eskalasi = naikkan ke atasan;
ngecek = memeriksa; nge-push = mengunggah; di-follow up = ditindaklanjuti; ngebahas = membahas; ngurusin = menangani; ngomongin = membicarakan;
mepet = sempit waktunya; molor = tertunda; kelar = selesai; rampung = selesai; kendala = masalah; ketemu = bertemu / ditemukan;
nanya = bertanya; minta tolong = permintaan bantuan; mas/mbak/bang/kak/pak/bu = sapaan hormat; oke/ok/sip = baik;
besok = hari berikutnya; lusa = dua hari lagi; minggu depan = minggu setelah ini; hari ini/tadi/kemarin = relatif terhadap tanggal rapat"""

def slang_lines():
    extra = HOME / ".mom/slang.txt"
    return SLANG + ("\n" + extra.read_text() if extra.exists() else "")

GLOSS = HOME / ".mom/glossary.txt"
def glossary():
    return [l.strip() for l in GLOSS.read_text().splitlines() if l.strip()] if GLOSS.exists() else []

def learn_terms(data):
    """Remember names and companies from finalised minutes so later transcripts spell them right."""
    new = [*data.get("telkomsel_names", []), *data.get("third_party_names", []), data.get("telkomsel_unit", ""), data.get("third_party_company", "")]
    have = glossary(); low = {h.lower() for h in have}
    add = [n for n in new if n and n.lower() not in low]
    if add: GLOSS.write_text("\n".join(have + add) + "\n")

def whisper_prompt():
    terms = ", ".join(glossary()[-40:])
    base = ("Meeting in English and Bahasa Indonesia, formal and casual, switching between them. "
            "Obrolan santai dan formal: gue, lo, nggak, udah, banget, sih, dong, deh, kok, wkwk, deploy, follow up, approval. "
            "Transcribe exactly as spoken, keep slang and English words as said.")
    return (base + (f" Terms: {terms}." if terms else ""))[:700]

HALLU = re.compile(r"^(thanks? for watching|thank you\.?|terima kasih\.?|subtitles? by.*|\W*)$", re.I)

def whisper(chunk: Path, lang: str):
    out = chunk.with_suffix("")
    cmd = ["whisper-cli", "-m", CFG["whisper_model"], "-f", str(chunk), "-l", lang, "-oj", "-of", str(out),
           "--prompt", whisper_prompt(), "--suppress-nst"]
    r = run(cmd)
    if r.returncode: raise SystemExit("whisper failed: " + r.stderr[-300:])
    return json.loads(Path(str(out) + ".json").read_text())

def transcribe(label, wav, tmp, total_done, n_total):
    total = duration(wav)
    cuts = cut_points(wav, total)
    segs = []
    for i in range(len(cuts) - 1):
        a, b = cuts[i], cuts[i + 1]
        stage(f"Transcribing {label}: {int(a // 60)} of {max(1, round(total / 60))} min")
        if b - a < 0.8 or mean_volume(wav, a, b) < -50: continue
        ch = tmp / f"{label}_{i:04d}.wav"
        run(["ffmpeg", "-y", "-ss", str(a), "-t", str(b - a), "-i", str(wav), "-c", "copy", str(ch)])
        j = whisper(ch, "auto")
        if j.get("result", {}).get("language") not in ("en", "id"):
            j = whisper(ch, "id")
        for s in j.get("transcription", []):
            t = s["text"].strip()
            if not t or HALLU.match(t): continue
            segs.append((a + s["offsets"]["from"] / 1000, label, t))
    return segs

def drop_echo(segs):
    """When the meeting plays through speakers the mic hears it too: drop 'Me' lines that repeat a nearby 'Others' line."""
    import difflib
    others = [x for x in segs if x[1] == "Others"]
    if not others: return segs
    keep = []
    for x in segs:
        if x[1] == "Me" and any(abs(o[0] - x[0]) <= 5 and difflib.SequenceMatcher(None, x[2].lower(), o[2].lower()).ratio() >= 0.6 for o in others):
            log("dropped echo: " + x[2]); continue
        keep.append(x)
    return keep

def ts(sec): return f"{int(sec // 3600):02d}:{int(sec % 3600 // 60):02d}:{int(sec % 60):02d}"

def ollama_up():
    try: urllib.request.urlopen("http://127.0.0.1:11434/api/version", timeout=2); return True
    except Exception: return False

def pick_model():
    """Use the configured model, else any installed one, else say exactly what to install."""
    try:
        tags = json.load(urllib.request.urlopen("http://127.0.0.1:11434/api/tags", timeout=5))["models"]
    except Exception:
        return
    names = [m["name"] for m in tags]
    if CFG["llm"] in names or any(n.split(":")[0] == CFG["llm"] for n in names): return
    if names: CFG["llm"] = names[0]; log("fallback model " + names[0])
    else: raise SystemExit(f"No language model installed. Run: ollama pull {CFG['llm']}")

def ensure_ollama():
    if ollama_up(): pick_model(); return
    subprocess.Popen(["ollama", "serve"], env={**os.environ, "OLLAMA_HOST": "127.0.0.1:11434", "NO_PROXY": "*"}, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(30):
        if ollama_up(): pick_model(); return
        time.sleep(1)
    raise SystemExit("Could not start Ollama")

def chat(system, user):
    body = json.dumps({"model": CFG["llm"], "stream": False, "think": False, "keep_alive": "2m",
                       "options": {"num_ctx": CFG["ctx"], "temperature": 0.2},
                       "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request("http://127.0.0.1:11434/api/chat", body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=3600) as r:
        txt = json.load(r)["message"]["content"]
    return re.sub(r"<think>.*?</think>", "", txt, flags=re.S).strip()

SYSTEM = """You write minutes of meeting (MoM) for a Telkomsel team from a raw speech-to-text transcript. The transcript mixes English and Bahasa Indonesia and may contain recognition errors; infer obvious corrections (product names, technical terms) but never invent facts.
Return JSON with:
- agenda: short meeting title, in the form "<Category> - <Subject>" using words actually said in the meeting, never copied from the examples.
- telkomsel_names / third_party_names: people who attended, only names actually said in the transcript. Telkomsel = internal staff; third party = vendors or other companies, and anyone said to be 'from' or 'dari' a company other than Telkomsel belongs under third party with that company. If unsure, put in telkomsel_names. Never guess names. Never list the labels Me, Others or Speaker as people.
- telkomsel_unit / third_party_company: unit or company name if stated, else "".
- topics: the "Topic Discussed" list. One numbered item per distinct topic, each a full sentence or two in the style of the examples: concise, formal, third person, passive voice. Cover the issue/background, what was agreed or decided, who does what, and dates/times/numbers exactly as stated. Include action items and owners inside the sentences ("... akan dilakukan oleh X paling lambat <tanggal>").
'Me' is the person who recorded ({me}); 'Others' are the other participants (voices not separated); 'Speaker' is an onsite room recording. Never write Me, Others or Speaker in the output: use the person's real name, or 'peserta rapat' when unknown.
Style examples of topics (Bahasa Indonesia):
{examples}
{lang}"""

SCHEMA = {"type": "object", "required": ["agenda", "telkomsel_names", "telkomsel_unit", "third_party_names", "third_party_company", "topics"],
          "properties": {"agenda": {"type": "string"}, "telkomsel_names": {"type": "array", "items": {"type": "string"}},
                         "telkomsel_unit": {"type": "string"}, "third_party_names": {"type": "array", "items": {"type": "string"}},
                         "third_party_company": {"type": "string"}, "topics": {"type": "array", "items": {"type": "string"}}}}

def chat(system, user, schema=None):
    payload = {"model": CFG["llm"], "stream": False, "think": False, "keep_alive": "2m",
               "options": {"num_ctx": CFG["ctx"], "temperature": 0.2},
               "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}]}
    if schema: payload["format"] = schema
    req = urllib.request.Request("http://127.0.0.1:11434/api/chat", json.dumps(payload).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=3600) as r:
        txt = json.load(r)["message"]["content"]
    return re.sub(r"<think>.*?</think>", "", txt, flags=re.S).strip()

def template_examples():
    try:
        import docx
        d = docx.Document(str(HOME / ".mom/template.docx"))
        return "\n".join(f"{i + 1}. {p.text}" for i, p in enumerate(p for p in d.paragraphs if p.style.name == "List Paragraph" and p.text.strip()))
    except Exception:
        return ""

def past_examples(current: Path, n=2):
    """Topics from the user's own last exported minutes, so new drafts match their wording."""
    out = []
    for d in sorted((HOME / "Documents/MoM").glob("*/"), reverse=True):
        if d == current or not (d / "MoM.pdf").exists(): continue
        try: out += json.loads((d / "MoM.json").read_text()).get("topics", [])[:3]
        except Exception: pass
        if len(out) >= n * 3: break
    return "\n".join(f"- {t}" for t in out[:n * 3])

MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
def nice_date(y, m, d):
    suf = "th" if 11 <= d <= 13 else {1: "st", 2: "nd", 3: "rd"}.get(d % 10, "th")
    return f"{MONTHS[m - 1]} {d}{suf}, {y}"

ANALYSIS_SCHEMA = {"type": "object", "required": ["summary", "decisions", "action_items", "open_questions"],
    "properties": {"summary": {"type": "string"},
                   "decisions": {"type": "array", "items": {"type": "string"}},
                   "action_items": {"type": "array", "items": {"type": "object", "required": ["task", "owner", "due"],
                       "properties": {"task": {"type": "string"}, "owner": {"type": "string"}, "due": {"type": "string"}}}},
                   "open_questions": {"type": "array", "items": {"type": "string"}},
                   "informal_terms": {"type": "array", "items": {"type": "string"}}}}

def analyse(transcript: str, meta: str):
    """Read the conversation the way a person would: what was decided, who took what, by when. Handles casual speech, slang and code-switching."""
    system = ("You are an experienced Indonesian corporate secretary who attended this meeting. The transcript is a raw speech-to-text of real, natural conversation: "
              "it mixes formal and informal (casual, slang, Jaksel-style) Bahasa Indonesia and English, with fillers, half sentences, interruptions, jokes and agreement noises. Read it as a human would.\n"
              "Understand slang and casual wording using this lexicon (said = meaning):\n" + slang_lines() + "\n"
              "Do the following:\n- Ignore filler, small talk and jokes unless they carry a decision.\n"
              "- Work out real intent: 'gas aja', 'oke sip', 'acc' mean agreement; 'nanti gue kabarin' is a commitment by the speaker; 'kayaknya', 'mungkin' mean not yet decided.\n"
              "- Who said it: " + "'Me' is the person who recorded the meeting, " + CFG["my_name"] + "; 'Others' are the remaining participants whose names are only known if said aloud. "
              "In your output never write the words Me, Others or Speaker: use " + CFG["my_name"] + " for Me, the person's name if it was said, or 'peserta rapat' / 'pihak terkait' when unknown.\n"
              "- Assign an owner only if a person is named or clearly the speaker; otherwise 'Unassigned'.\n"
              "- Convert relative dates (besok, lusa, minggu depan, nanti sore) to absolute dates using the meeting date given; if unclear write 'TBD'.\n"
              "- decisions: only what was actually agreed. action_items: concrete tasks with owner and due. open_questions: unresolved points.\n"
              "- informal_terms: any slang you had to interpret, as 'said = meaning'.\n"
              "- summary: 2-3 plain sentences of what the meeting was about.\n"
              "Write in formal Bahasa Indonesia (keep English technical terms). Never invent facts.")
    return json.loads(chat(system, f"MEETING INFO: {meta}\n\nTRANSCRIPT:\n{transcript}", ANALYSIS_SCHEMA))

def make_mom(transcript: str, session: Path):
    lang = {"auto": "Write the topics in Bahasa Indonesia, keeping English technical terms as spoken.",
            "en": "Write the topics in English.", "id": "Write the topics in Bahasa Indonesia."}.get(CFG["mom_language"], "Write the topics in Bahasa Indonesia.")
    ex = template_examples()
    mine = past_examples(session)
    if mine: ex += "\nMore examples from this user's earlier minutes (match their wording):\n" + mine
    system = SYSTEM.format(lang=lang, examples=ex, me=CFG["my_name"])
    gl = glossary()
    if gl: system += "\nKnown names and terms, SPELLING REFERENCE ONLY (use these spellings when the transcript has a similar-sounding word). These people and terms are NOT necessarily in this meeting: never add anyone to the attendee lists unless the transcript mentions them: " + "; ".join(gl[-80:])
    if len(transcript) > 60000:  # map-reduce for very long meetings
        parts, cur = [], ""
        for line in transcript.splitlines(keepends=True):
            if len(cur) + len(line) > 40000: parts.append(cur); cur = ""
            cur += line
        parts.append(cur)
        notes = []
        for i, p in enumerate(parts):
            stage(f"Summarising part {i + 1} of {len(parts)}")
            notes.append(chat("Condense this meeting transcript part into detailed bullet notes: topics, who said what, decisions, action items with owners and due dates, numbers, names.", p))
        transcript = "\n\n".join(notes)
    n0 = session.name
    meta = f"Recorded {n0[:10]} at {n0[11:13]}:{n0[13:15]}"
    try:
        import datetime
        meta += " (" + datetime.date(int(n0[:4]), int(n0[5:7]), int(n0[8:10])).strftime("%A") + ")"
    except Exception: pass
    notes = ""
    try:
        stage("Understanding the conversation")
        an = analyse(transcript, meta)
        (session / "analysis.json").write_text(json.dumps(an, ensure_ascii=False, indent=2))
        notes = "\n\nANALYSIS OF THE MEETING (use it, but stay faithful to the transcript):\n" + json.dumps(an, ensure_ascii=False)
    except Exception as e:
        log("analysis skipped: " + repr(e))
    system += "\nThe transcript is casual and mixed-register. Write the minutes in formal, professional language regardless of how informally it was spoken; do not copy slang. Express relative dates as absolute dates."
    stage("Writing the MoM")
    data = json.loads(chat(system, f"MEETING INFO: {meta}\n\nTRANSCRIPT:\n{transcript}{notes}", SCHEMA))
    # second pass: check the draft against the transcript and drop anything it does not support
    try:
        stage("Checking the minutes against the transcript")
        checked = json.loads(chat(
            "You are a strict fact-checker for minutes of meeting. Compare the DRAFT with the TRANSCRIPT. Remove or correct any statement, name, number, date or owner that the transcript does not support. Fix names and terms to match the known spellings" + (" (spelling reference only; remove any attendee that the transcript does not mention): " + "; ".join(gl[-80:]) if gl else "") + ". Keep the style and language. Do not add new topics unless an important decision or action item in the transcript is missing, then add it. Return the corrected draft in the same JSON format.",
            f"MEETING INFO: {meta}\n\nTRANSCRIPT (casual speech; slang lexicon: {slang_lines()[:1500]}):\n{transcript}\n\nDRAFT:\n{json.dumps(data, ensure_ascii=False)}", SCHEMA))
        if checked.get("topics"): data = checked
    except Exception as e:
        log("verify pass skipped: " + repr(e))
    for k in ("telkomsel_names", "third_party_names"):
        data[k] = [x for x in data.get(k, []) if x.strip().lower() not in ("me", "others", "speaker", "unidentified", "unknown")]
    low = transcript.lower()
    def mentioned(n):
        return any(len(t) >= 3 and t.lower() in low for t in n.split())
    for k in ("telkomsel_names", "third_party_names"):
        data[k] = [x for x in data.get(k, []) if mentioned(x)]   # never list someone the transcript does not mention
    me = CFG["my_name"]
    if me and me.lower() not in [x.lower() for x in data.get("telkomsel_names", [])]:
        data["telkomsel_names"] = [me] + [x for x in data.get("telkomsel_names", []) if not x.lower().startswith(me.lower().split()[0]) or x.lower() == me.lower()]
        if not data.get("telkomsel_unit") and CFG.get("my_unit"): data["telkomsel_unit"] = CFG["my_unit"]
    data["topics"] = [re.sub(r"\b(Me|Others|Speaker)\b", lambda m_: me if m_.group(1) == "Me" else "peserta rapat", t) for t in data.get("topics", [])]
    n = session.name
    try:
        y, mo, d = int(n[:4]), int(n[5:7]), int(n[8:10]); hh, mm = int(n[11:13]), int(n[13:15])
        data["date"] = nice_date(y, mo, d)
        data["time"] = f"{(hh % 12) or 12}:{mm:02d} {'AM' if hh < 12 else 'PM'}"
    except Exception:
        data.setdefault("date", ""); data.setdefault("time", "")
    return data

# ---------- export: MoM.json + template.docx -> MoM.docx + MoM.pdf ----------
def set_lines(tc_cell, lines):
    """Replace the text of a table cell with one paragraph per line, keeping the first paragraph's formatting."""
    import copy
    paras = tc_cell.paragraphs
    proto = copy.deepcopy(paras[0]._p)
    for p in paras: p._p.getparent().remove(p._p)
    tc = tc_cell._tc
    for line in (lines or [""]):
        p = copy.deepcopy(proto)
        runs = p.findall("{http://schemas.openxmlformats.org/wordprocessingml/2006/main}r")
        for r in runs[1:]: p.remove(r)
        if runs:
            ts_ = runs[0].findall("{http://schemas.openxmlformats.org/wordprocessingml/2006/main}t")
            for t in ts_[1:]: runs[0].remove(t)
            if ts_: ts_[0].text = line; ts_[0].set("{http://www.w3.org/XML/1998/namespace}space", "preserve")
        tc.append(p)

def export(d: Path):
    import docx, copy
    data = json.loads((d / "MoM.json").read_text())
    learn_terms(data)
    doc = docx.Document(str(HOME / ".mom/template.docx"))
    t = doc.tables[0]
    set_lines(t.rows[0].cells[1], [data.get("agenda", "")])
    set_lines(t.rows[1].cells[1], [data.get("date", "")])
    set_lines(t.rows[2].cells[1], [data.get("time", "")])
    set_lines(t.rows[5].cells[0], data.get("telkomsel_names", []))
    set_lines(t.rows[5].cells[1], [data.get("telkomsel_unit", "")])
    set_lines(t.rows[7].cells[0], data.get("third_party_names", []))
    set_lines(t.rows[7].cells[2], [data.get("third_party_company", "")])
    items = [p for p in doc.paragraphs if p.style.name == "List Paragraph"]
    proto = copy.deepcopy(items[0]._p); anchor = items[-1]._p
    W = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
    for topic in data.get("topics", []):
        p = copy.deepcopy(proto)
        runs = p.findall(W + "r")
        for r in runs[1:]: p.remove(r)
        ts_ = runs[0].findall(W + "t")
        for x in ts_[1:]: runs[0].remove(x)
        ts_[0].text = topic; ts_[0].set("{http://www.w3.org/XML/1998/namespace}space", "preserve")
        anchor.addnext(p); anchor = p
    for p in items: p._p.getparent().remove(p._p)
    out = d / "MoM.docx"
    doc.save(str(out))
    stage("Creating PDF")
    final_pdf = d / "MoM.pdf"
    if final_pdf.exists(): final_pdf.unlink()
    # Word opens files in synced or quarantined folders in Protected View, which cannot export. Convert a copy in a plain work folder.
    work = HOME / ".mom/work"; work.mkdir(parents=True, exist_ok=True)
    out = work / "MoM.docx"; shutil.copy2(d / "MoM.docx", out)
    run(["xattr", "-c", str(out)])
    pdf = work / "MoM.pdf"
    if pdf.exists(): pdf.unlink()
    script = f'''tell application "Microsoft Word"
  open POSIX file "{out}"
  repeat 40 times
    try
      if (count of documents) > 0 then exit repeat
    end try
    delay 0.5
  end repeat
  set dd to active document
  save as dd file name "{pdf}" file format format PDF
  close dd saving no
end tell'''
    err = ""
    for attempt in range(3):
        r = run(["osascript", "-e", script])
        if pdf.exists(): break
        err = r.stderr[-300:]; log(f"pdf attempt {attempt + 1} failed: {err}")
        run(["osascript", "-e", 'tell application "Microsoft Word" to close every document saving no'])
        time.sleep(2)
    if not pdf.exists():
        raise SystemExit("PDF export failed (needs Microsoft Word; the Word file was saved): " + err)
    shutil.move(str(pdf), str(final_pdf)); out.unlink(missing_ok=True)
    print("DONE", d, flush=True)

# ---------- tidy: clean up spacing, wording, punctuation of an edited MoM.json ----------
def tidy_text(t, sentence=True):
    t = re.sub(r"\s+", " ", t or "").strip()
    t = re.sub(r"\s+([,.;:!?])", r"\1", t)                    # no space before punctuation
    t = re.sub(r"([,;:!?])(?=[^\s\d,;:!?)\]\"'])", r"\1 ", t)   # one space after
    if sentence and t:
        t = t[0].upper() + t[1:]
        if t[-1] not in ".!?:)": t += "."
    return t

def tidy_name(n):
    n = re.sub(r"\s+", " ", n or "").strip(" ,;")
    return n.title() if n and (n.islower() or n.isupper()) else n

def tidy_names(names):
    out, seen = [], set()
    for n in names:
        n = tidy_name(n)
        if n and n.lower() not in seen: seen.add(n.lower()); out.append(n)
    return out

TIDY_SYSTEM = """You are a careful copy editor for formal corporate minutes of meeting. You receive the topic list of a MoM.
Fix spelling, grammar, spacing, punctuation and awkward wording. Make each topic a clear, concise, formal sentence or two (passive voice is fine). Keep the language of each topic (Bahasa Indonesia stays Bahasa Indonesia; keep English technical terms). Keep every fact, name, number, date, time and owner exactly; never add or remove information. Keep the same number of topics in the same order. If a topic is already good, return it unchanged."""

def tidy(d: Path):
    f = d / "MoM.json"
    data = json.loads(f.read_text())
    (d / "MoM.pre-tidy.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
    stage("Tidying")
    data["agenda"] = tidy_text(data.get("agenda", ""), sentence=False)
    data["telkomsel_unit"] = tidy_text(data.get("telkomsel_unit", ""), sentence=False)
    data["third_party_company"] = tidy_text(data.get("third_party_company", ""), sentence=False)
    data["telkomsel_names"] = tidy_names(data.get("telkomsel_names", []))
    data["third_party_names"] = tidy_names(data.get("third_party_names", []))
    topics = [tidy_text(t) for t in data.get("topics", []) if t.strip()]
    if topics:
        try:
            stage("Polishing the wording")
            ensure_ollama()
            schema = {"type": "object", "required": ["topics"], "properties": {"topics": {"type": "array", "items": {"type": "string"}}}}
            out = json.loads(chat(TIDY_SYSTEM, json.dumps({"topics": topics}, ensure_ascii=False), schema))
            new = [tidy_text(t) for t in out.get("topics", [])]
            if len(new) == len(topics) and all(new): topics = new   # only accept a faithful, same-length rewrite
        except Exception as e:
            print("tidy: wording pass skipped:", e, flush=True)
    data["topics"] = topics
    f.write_text(json.dumps(data, ensure_ascii=False, indent=2))
    print("DONE", d, flush=True)

def ask(d: Path, question: str):
    tr = (d / "transcript.md").read_text() if (d / "transcript.md").exists() else ""
    if not tr: raise SystemExit("This meeting has no transcript yet.")
    ensure_ollama()
    mom = (d / "MoM.json").read_text() if (d / "MoM.json").exists() else ""
    print(chat("You answer questions about one meeting using only its transcript (and minutes). Answer briefly and plainly in the language of the question. Quote the timestamp [hh:mm:ss] where the answer is said. If the meeting does not say, answer that it was not discussed.",
               f"TRANSCRIPT:\n{tr[:80000]}\n\nMINUTES:\n{mom}\n\nQUESTION: {question}"))

def main():
    global LOGF
    args = sys.argv[1:]
    if len(args) >= 2 and not args[0].startswith("--"):
        pass
    for a in args:
        if not a.startswith("--") and Path(a).expanduser().is_dir():
            LOGF = Path(a).expanduser() / "mom.log"; break
    if args and args[0] == "--ask":
        return ask(Path(args[1]).expanduser().resolve(), " ".join(args[2:]))
    if not args: raise SystemExit(__doc__)
    if args[0] == "--tidy":
        return tidy(Path(args[1]).expanduser().resolve())
    if args[0] == "--export":
        return export(Path(args[1]).expanduser().resolve())
    d, tracks = prepare(Path(args[0]).expanduser().resolve())
    if not tracks: raise SystemExit("No audio found in " + str(d))
    if not Path(CFG["whisper_model"]).exists(): raise SystemExit("Whisper model missing: " + CFG["whisper_model"])
    segs = []
    with tempfile.TemporaryDirectory() as t:
        tmp = Path(t)
        for label, src in tracks:
            stage(f"Preparing {label} audio")
            wav = tmp / f"{label}.wav"; to_wav(src, wav)
            segs += transcribe(label, wav, tmp, 0, len(tracks))
    segs.sort(key=lambda x: x[0])
    segs = drop_echo(segs)
    lines, prev = [], None
    for s, who, text in segs:
        if prev and prev[0] == who and s - prev[1] < 8: lines[-1] += " " + text
        else: lines.append(f"[{ts(s)}] {who}: {text}")
        prev = (who, s + 1)
    transcript = "\n".join(lines)
    (d / "transcript.md").write_text("# Transcript\n\n" + transcript + "\n")
    if len(transcript) < 80: raise SystemExit("Transcript is nearly empty. Check microphone / meeting audio levels.")
    ensure_ollama()
    data = make_mom(transcript, d)
    (d / "MoM.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
    print("DONE", d, flush=True)

if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        import traceback
        log(traceback.format_exc())
        print(f"{type(e).__name__}: {e}", flush=True)
        sys.exit(1)
